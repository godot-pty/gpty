# Maintainer: gpty contributors
# GitHub: https://github.com/gpty/gpty
pkgname=gpty-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Multi-PTY terminal emulator with tiling grid GUI"
arch=('x86_64')
url="https://github.com/gpty/gpty"
license=('Apache-2.0')
depends=()
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/gpty-v$pkgver-linux-x86_64.tar.gz"
        "gpty.desktop")
sha256sums=('SKIP'
            'SKIP')

package() {
    tar -xzf "$srcdir/$pkgname-$pkgver.tar.gz" -C "$srcdir"
    install -Dm755 "$srcdir/gpty-v$pkgver-linux-x86_64/gpty" "$pkgdir/usr/bin/gpty"
    install -Dm644 "$srcdir/gpty.desktop" "$pkgdir/usr/share/applications/gpty.desktop"
}
