# ── Rust ──────────────────────────────────────────────────────────────────
/target/
**/*.rs.bk
.cargo/config.toml

# Compiled GDExtension libraries
*.so
*.dylib
*.dll

# ── Godot ─────────────────────────────────────────────────────────────────
# Godot 4+ project files (keep project.godot, but ignore imports)
godot/.import/
godot/.godot/
godot/*.import
godot/export/

# Godot-specific transient files
*.translation
godot/.mono/
godot/mono_crash.*.json
godot/tests/bench/.gate-probe.gd*
godot/tests/bench/_gate_probe.gd*

# ── IDE / Editor ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Misc ──────────────────────────────────────────────────────────────────
*.log
*.orig
*.patch
.env
.env.local

# ── Secrets ───────────────────────────────────────────────────────────────
# scripts/check-secrets and .github/workflows/secret-scan.yml enforce this;
# these patterns keep the common credential files out of `git add`.
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
secrets.json

# AI
reasonix.toml
.reasonix/

# Local audit (delete when resolved)
TEMP*
AUDIT.md
.omp/*
# Committed agent skills: OMP's native project provider scans .omp/skills/<name>/SKILL.md
!.omp/skills/
!.omp/skills/**

docs/public/
docs/.hugo_build.lock
docs/resources/
docs/assets/repo/
# Generated by docs/setup.sh, except the tracked icon overlay.
docs/data/*
!docs/data/icons.yaml
# The cost ledger the README chart is rendered from (scripts/render-cost-chart).
!docs/data/cost-history.json
# The capability catalogue, one file per area (scripts/check-capabilities
# gates it; docs-check reads markdown only, so this is its only consumer).
!docs/data/capabilities/
docs/.cache/

# ── Local build output (scripts/build) ────────────────────────────────────
# Export staging (scripts/build); its EXIT trap normally removes it
dist/.stage.*
dist/gpty
dist/gpty.pck
dist/gpty.exe
dist/gpty.zip
dist/gpty_gdext.windows.x86_64.dll
dist/gpty.sh

# Pinned FFmpeg build (scripts/media-deps)
dist/ffmpeg/

# Local media bundle output (scripts/build -> scripts/bundle-media)
dist/lib*.so*
dist/licenses/

# Bytecode from `scripts/audit-probes.py` importing `scripts/smoke_pane_api.py`
__pycache__/
*.pyc
