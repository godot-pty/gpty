#!/usr/bin/env bash
# pre-commit: fast CI checks (fmt + workflow lint + clippy)
# Delegates to scripts/ci-check --fast

REPO_ROOT="$(git rev-parse --show-toplevel)"
CI_CHECK="$REPO_ROOT/scripts/ci-check"

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
case "$branch" in
    main|master)
        echo "ERROR: $branch is protected; create a work branch before committing" >&2
        exit 1
        ;;
esac

if [[ -x "$CI_CHECK" ]]; then
    exec "$CI_CHECK" --fast
else
    echo "ERROR: scripts/ci-check not found or not executable" >&2
    echo "Run: ./scripts/install-hooks first" >&2
    exit 1
fi
