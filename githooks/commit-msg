#!/usr/bin/env bash
# commit-msg: enforce Conventional Commits format and the DCO sign-off
# Validates the message against the types and scopes from AGENTS.md, and
# requires a Signed-off-by trailer (git commit -s).

COMMIT_MSG_FILE="$1"
COMMIT_MSG="$(cat "$COMMIT_MSG_FILE")"

# Types and scopes from AGENTS.md
TYPES="feat|fix|chore|docs|style|refactor|perf|test|ci|build|revert"
SCOPES="settings|terminal|layout|workspace|sidebar|ui|gdext|core|cli|ipc|profiles|concepts|icons|ci|ai|inspector"

# Regex: type(scope): description  — scope is optional
PATTERN="^(${TYPES})(\((${SCOPES})\))?!?: .+"

# DCO: every commit asserts the right to submit it. `git commit -s` adds the trailer.
if ! grep -qE '^Signed-off-by: .+ <[^ <>]+@[^ <>]+>$' "$COMMIT_MSG_FILE"; then
    echo "ERROR: Commit message is missing a DCO sign-off." >&2
    echo "Use 'git commit -s' to add 'Signed-off-by: Name <email>'." >&2
    exit 1
fi

# Cause: a fix names the defect class it closes, so the classes can be counted
# (scripts/fix-forensics) and a class that recurs gets a control instead of a
# fourth prose bullet. The taxonomy lives in the script, not here.
SUBJECT="$(grep -m1 -vE '^[[:space:]]*(#|$)' "$COMMIT_MSG_FILE" || true)"
if printf '%s\n' "$SUBJECT" | grep -qE '^fix(\(|!|: )'; then
    ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    if ! CLASSES="$("$ROOT/scripts/fix-forensics" --classes 2>/dev/null)"; then
        echo "WARNING: scripts/fix-forensics cannot run; skipping the Cause: check." >&2
    else
        CAUSES="$(grep -cE '^Cause: [a-z-]+$' "$COMMIT_MSG_FILE" || true)"
        CAUSE="$(grep -m1 -E '^Cause: [a-z-]+$' "$COMMIT_MSG_FILE" | sed 's/^Cause: //' || true)"
        if [ "$CAUSES" -ne 1 ] || ! printf '%s\n' "$CLASSES" | grep -qxF -- "$CAUSE"; then
            echo "ERROR: a fix commit needs exactly one 'Cause: <class>' trailer." >&2
            echo "" >&2
            echo "Valid classes:" >&2
            printf '%s\n' "$CLASSES" | sed 's/^/  /' >&2
            echo "" >&2
            echo "Guide: docs/content/docs/agents/defect-classes.md" >&2
            echo "Trailer: Cause: one-fact-two-copies" >&2
            exit 1
        fi
    fi
fi

if echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    exit 0
fi

echo "ERROR: Commit message does not match Conventional Commits format." >&2
echo "" >&2
echo "Expected: type(scope): description" >&2
echo "  type:  $TYPES" >&2
echo "  scope: $SCOPES" >&2
echo "" >&2
echo "Examples:" >&2
echo "  feat(core): add streaming output capture" >&2
echo "  fix(terminal): repair resize cascade" >&2
echo "  chore(deps): bump tokio to 1.43" >&2
echo "  docs: update README for v0.3.0" >&2
echo "" >&2
echo "Bypass: git commit -n (not recommended)" >&2
exit 1
