#!/usr/bin/env bash
# pre-push: CI suite before pushing
# Delegates to scripts/ci-check --stamped. The pushed range is handed over as
# CI_CHECK_RANGE_FROM so a documentation-only push can narrow to the docs gates
# (scripts/ci-check decides; CI_CHECK_FULL=1 forces the full suite). Git writes
# one line per ref to stdin: <local ref> <local sha> <remote ref> <remote sha>.
#
# Tags and branch deletes never need the app matrix: a tag is validated by the
# release workflow, and a delete changes no source. A new branch has no remote
# base, so it is classified against its merge-base with origin/main; a missing
# base or a multi-ref push still means the full suite. The --stamped path lets a
# repeated push of the same clean tree skip the suite it already passed.
#
# The gate prints a summary (one named result per gate, logs in
# /tmp/gpty-ci-check) rather than every gate's output; CI_CHECK_VERBOSE=1
# streams it instead.

REPO_ROOT="$(git rev-parse --show-toplevel)"
CI_CHECK="${CI_CHECK_BIN:-$REPO_ROOT/scripts/ci-check}"

RANGE_FROM=""
RANGE_USABLE=true
REFS=0
LOCAL_SHA=""
while read -r _local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/*) ;;
        *)
            echo "pre-push: $remote_ref is not a branch - no gate"
            continue
            ;;
    esac
    if [[ "$local_sha" =~ ^0+$ ]]; then
        echo "pre-push: deleting $remote_ref - no gate"
        continue
    fi
    REFS=$((REFS + 1))
    LOCAL_SHA="$local_sha"
    if [[ -z "$remote_sha" || "$remote_sha" =~ ^0+$ ]]; then
        RANGE_USABLE=false
        continue
    fi
    if [[ -z "$RANGE_FROM" ]]; then
        RANGE_FROM="$remote_sha"
    elif [[ "$RANGE_FROM" != "$remote_sha" ]]; then
        RANGE_USABLE=false
    fi
done

if [[ $REFS -eq 0 ]]; then
    exit 0
fi

if ! $RANGE_USABLE && [[ $REFS -eq 1 && -n "$LOCAL_SHA" ]]; then
    if BASE="$(git merge-base "$LOCAL_SHA" origin/main 2>/dev/null)" && [[ -n "$BASE" ]]; then
        RANGE_FROM="$BASE"
        RANGE_USABLE=true
    fi
fi
if $RANGE_USABLE && [[ -n "$RANGE_FROM" ]]; then
    export CI_CHECK_RANGE_FROM="$RANGE_FROM"
fi

if [[ -x "$CI_CHECK" ]]; then
    SUMMARY=()
    [[ "${CI_CHECK_VERBOSE:-0}" == "1" ]] || SUMMARY=(--summary)
    "$CI_CHECK" --stamped "${SUMMARY[@]}"
    STATUS=$?
    if [[ $STATUS -ne 0 ]]; then
        echo ""
        echo "Push blocked. Fix failures or bypass with: git push --no-verify"
    fi
    exit $STATUS
else
    echo "ERROR: scripts/ci-check not found or not executable" >&2
    echo "Run: ./scripts/install-hooks first" >&2
    exit 1
fi
