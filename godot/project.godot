; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="gPTY"
config/version="0.8.5"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"
; The engine draws this frame before any script, so it cannot read the palette:
; the surface and the art are fixed. Keep Width preserves the 16:9 frame; a 4:3
; window letterboxes in the same SURFACE as the art's edge, and a wider window
; crops only the flat edge, never the mark.
boot_splash/image="res://assets/boot_splash.png"
boot_splash/bg_color=Color(0.12549, 0.129412, 0.156863, 1)
boot_splash/stretch_mode=2

[autoload]

FocusManager="*res://scenes/autoloads/focus_manager.gd"
ToastManager="*res://scenes/autoloads/toast_manager.gd"
ShortcutManager="*res://scenes/autoloads/shortcut_manager.gd"
SettingsManager="*res://scenes/autoloads/settings_manager.gd"
ProfileManager="*res://scenes/autoloads/profile_manager.gd"
ConceptManager="*res://scenes/autoloads/concept_manager.gd"
UpdateChecker="*res://scenes/autoloads/update_checker.gd"
WorkspaceStore="*res://scenes/autoloads/workspace_store.gd"
PaneEnvStore="*res://scenes/autoloads/pane_env_store.gd"
PaneCwdStore="*res://scenes/autoloads/pane_cwd_store.gd"
PaneSchemeStore="*res://scenes/autoloads/pane_scheme_store.gd"
PaneInspectorStore="*res://scenes/autoloads/pane_inspector_store.gd"
TrustedStore="*res://scenes/autoloads/trusted_store.gd"
LinkWeightsStore="*res://scenes/autoloads/link_weights_store.gd"
SavedCommandStore="*res://scenes/autoloads/saved_command_store.gd"
KnowledgeStore="*res://scenes/autoloads/knowledge_store.gd"
VaultRegistry="*res://scenes/autoloads/vault_registry.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
; Window opacity (Settings -> System) needs this: the engine answers
; `is_window_transparency_available()` false without it, even on a renderer
; that supports it. The window stays opaque until the setting asks otherwise.
window/per_pixel_transparency/allowed=true

[rendering]

; The renderer decision (2026-11-22 bake-off): Forward+ is the default on every
; platform because the orbital vault graph's bloom is the v0.8.6 identity.
; Compatibility (OpenGL3) is 2.2x lighter and the documented opt-in
; (--rendering-driver opengl3). A future per-platform flip is one project-setting
; override (renderer/rendering_method.<linuxbsd|windows|macos>), not a preset key.
renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
