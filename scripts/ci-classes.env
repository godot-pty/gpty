# Changed-path classes. Sourced by scripts/ci-check and scripts/classify-changes:
# add a path here, never in a per-file copy.
DOCS_PATTERNS=(
    'docs/*'
    'assets/site-icons/*'
    '*.md'
    '.github/workflows/*'
    'godot/knowledge.json'
    'godot/docs.json'
    'LICENSE'
    'scripts/docs-check'
    'scripts/check-capabilities'
    'scripts/build-wiki'
    'scripts/build-docs'
    'scripts/roadmap'
)
NODE_PATTERNS=( 'extensions/gpty-omp-events/*' )
RUST_PATTERNS=(
    'crates/*'
    'Cargo.toml'
    'Cargo.lock'
    'rust-toolchain.toml'
    'fuzz/*'
    'scripts/install-rust'
    'scripts/media-deps'
    'dist/ffmpeg/*'
)
MACOS_PATTERNS=(
    'crates/gpty-ipc/*'
    'crates/gpty-gdext/build.rs'
    'crates/gpty-media/*'
    'Cargo.toml'
    'Cargo.lock'
    'rust-toolchain.toml'
    'scripts/install-rust'
    'scripts/media-deps'
    'dist/ffmpeg/*'
)
TOOLING_PATTERNS=(
    'scripts/measure-cost'
    'scripts/render-cost-chart'
    'scripts/backfill-cost-history'
    'scripts/fix-forensics'
    'scripts/install-cli'
    'scripts/check-secrets'
    'scripts/bot-token'
    'scripts/pr'
    'scripts/git-askpass-token'
    'scripts/check-github-settings'
    'scripts/install-rust'
    'scripts/install-godot'
    'scripts/release-prepare'
    'scripts/dev-linker'
    'scripts/export-check'
)
