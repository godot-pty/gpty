#!/usr/bin/env bash
# Record a scripted gPTY demo and encode it for the README and docs site.
#
# Launches the app in a sandbox (fresh user-data dir, throwaway HOME, its own
# IPC socket, so a running gPTY is never touched), seeds a workspace, drives it
# with the gpty CLI exactly the way an agent would, records the app window with
# ffmpeg, then burns captions in and writes a GIF, an MP4 and a WebM.
#
# Usage: scripts/record-demo <showcase|panes|agents|concepts|wiki|media|cli-view|profiles> [out-dir]
#   out-dir defaults to docs/static/images; files are demo-<scenario>.{gif,mp4,webm}
#
# One scenario is one workflow, and every action in it is a `gpty` call a reader
# can repeat: no synthetic input, no staged screenshot. `showcase` is the single
# clip the README always shows; the rest pair with one feature section each.
#
# Build first: `cargo build --workspace` (the GUI loads the debug GDExtension and the
# panes use target/debug/gpty). Override the GUI command with DEMO_APP.
#
# Env: DEMO_FONT=22       font size (large enough to read at GIF width)
#      DEMO_SIZE=1280x760  window size        DEMO_FPS=15   capture frame rate
#      GIF_WIDTH=1000      showcase GIF width  GIF_FPS=12   showcase GIF frame rate
#      GIF_WIDTH_OVERRIDE  GIF width for the feature clips (default 900)
#      GIF_FPS_OVERRIDE    GIF frame rate for the feature clips (default 10)
#      DEMO_KEEP=1         keep the raw capture and cue files next to the output
#
# Requires: ffmpeg (x11grab, drawtext), python3 + python-xlib, git, a graphical
# session with XWayland (DISPLAY set). No input is simulated: each step injects a
# whole command line through the gpty CLI, and the layout is seeded already open (a
# wiki pane restores its note and graph), so the run never touches your keyboard,
# pointer, or input permissions.
set -euo pipefail
export LC_ALL=C

SCENARIO="${1:?usage: record-demo <showcase|panes|agents|concepts|wiki|media|cli-view|profiles> [out-dir]}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT_DIR="${2:-$ROOT/docs/static/images}"
SIZE="${DEMO_SIZE:-1280x760}"
FPS="${DEMO_FPS:-15}"
GIF_WIDTH="${GIF_WIDTH:-1000}"
GIF_FPS="${GIF_FPS:-12}"
# Where a burned-in caption sits: the default is the bottom centre, which is
# also where a toast appears. A clip whose point is the toast puts its (short)
# caption at the bottom left instead of covering the question.
CAPTION_POS="${CAPTION_POS:-}"
case "$SCENARIO" in
    showcase | panes | agents | concepts | wiki | media | cli-view | profiles) ;;
    *) echo "scenario must be one of: showcase panes agents concepts wiki media cli-view profiles" >&2; exit 2 ;;
esac
# The README shows the showcase clip at full width; a feature clip rides inside
# an expanded section, so it can be smaller and cheaper. `profiles` is the
# exception: it shows the three-pane Agent Workspace, and a pane narrower than
# a third of 900 px is a texture rather than information.
case "$SCENARIO" in
    showcase) ;;
    profiles)
        # Three panes: 900 px is a texture rather than information, and this
        # clip's own beats are the profile toast, so each caption is short and
        # sits bottom left, clear of the toast at bottom centre.
        GIF_WIDTH="${GIF_WIDTH_OVERRIDE:-1000}"
        GIF_FPS="${GIF_FPS_OVERRIDE:-10}"
        CAPTION_POS="${CAPTION_POS:-x=20:y=h-text_h-22}"
        ;;
    *)
        GIF_WIDTH="${GIF_WIDTH_OVERRIDE:-900}"
        GIF_FPS="${GIF_FPS_OVERRIDE:-10}"
        ;;
esac

for tool in ffmpeg python3 git; do
    command -v "$tool" >/dev/null || { echo "missing tool: $tool" >&2; exit 3; }
done
python3 -c 'import Xlib' 2>/dev/null || { echo "missing python-xlib" >&2; exit 3; }
[[ -n "${DISPLAY:-}" ]] || { echo "no DISPLAY - the app window must exist on X11/XWayland" >&2; exit 3; }
[[ -x "$ROOT/target/debug/gpty" ]] || { echo "build first: cargo build --workspace" >&2; exit 3; }

TMP="$(mktemp -d)"
APP_PID="" REC_PID=""
cleanup() {
    [[ -n "$REC_PID" ]] && kill "$REC_PID" 2>/dev/null || true
    [[ -n "$APP_PID" ]] && kill "$APP_PID" 2>/dev/null || true
    [[ -n "$APP_PID" ]] && wait "$APP_PID" 2>/dev/null || true
    if [[ "${DEMO_KEEP:-}" != 1 ]]; then rm -rf "$TMP"; else echo "kept: $TMP"; fi
}
trap cleanup EXIT

# ── sandbox ──────────────────────────────────────────────────────────────
export HOME="$TMP/home"
export XDG_DATA_HOME="$TMP/data"
export XDG_CONFIG_HOME="$TMP/config"
export GPTY_SOCKET="$TMP/gpty.sock"
export SHELL=/bin/bash
export PATH="$ROOT/target/debug:$PATH"
mkdir -p "$HOME" "$XDG_DATA_HOME" "$XDG_CONFIG_HOME"
cp -r "$ROOT/scripts/demo/project/." "$HOME/"
cp -r "$ROOT/scripts/demo/vault" "$HOME/vault"
# A short prompt the default `cat` concept recognises ("<anything>$ cat ...").
cat >"$HOME/.bashrc" <<'RC'
PS1='\[\e[1;32m\]demo\[\e[0m\]:\[\e[1;34m\]~\[\e[0m\]$ '
export PATH="__ROOT__/target/debug:$PATH"
# A pane strips GPTY_SOCKET from its environment, so without this the CLI typed
# into a pane would reach whatever gPTY owns the default socket (a real session).
export GPTY_SOCKET="__SOCK__"
RC
sed -i "s#__ROOT__#$ROOT#; s#__SOCK__#$GPTY_SOCKET#" "$HOME/.bashrc"
(
    cd "$HOME"
    export GIT_AUTHOR_NAME=demo GIT_AUTHOR_EMAIL=demo@example.com GIT_COMMITTER_NAME=demo GIT_COMMITTER_EMAIL=demo@example.com
    git init -q -b main .
    git add src counts.py test_counts.py .gitignore
    git commit -q -m "word counts for log lines"
    echo "// sorted output" >>src/main.rs && git commit -q -am "sort the output"
    git commit -q --allow-empty -m "add CI workflow"
    git commit -q --allow-empty -m "release 0.1"
    # Left uncommitted on purpose: the concept's `git diff` needs a change to
    # route, and `git status` needs a file to name. No clip stages it.
    echo "// demo change" >>src/main.rs
)
if [[ "$SCENARIO" == media ]]; then
    # `testsrc` (not testsrc2): static colour bars with one moving box and a
    # running timer, so the clip proves playback while the GIF stays small.
    ffmpeg -loglevel error -y -f lavfi -i "testsrc=size=640x360:rate=24" \
        -f lavfi -i "sine=frequency=330:sample_rate=48000" -t 30 \
        -c:v libx264 -pix_fmt yuv420p -c:a aac "$HOME/clip.mp4"
fi

# ── seed the workspace ───────────────────────────────────────────────────
DATA_DIR="$XDG_DATA_HOME/godot/app_userdata/gPTY"
mkdir -p "$DATA_DIR"
SCENARIO="$SCENARIO" HOME_DIR="$HOME" python3 - >"$DATA_DIR/workspaces.json" <<'PY'
import json, os
home, scenario = os.environ["HOME_DIR"], os.environ["SCENARIO"]
FONT = int(os.environ.get("DEMO_FONT", "22"))  # large enough to read at GIF width
def tile(col, row, cspan, rspan, **settings):
    return {"col": col, "row": row, "cspan": cspan, "rspan": rspan, "settings": settings}

# Each grid is 60 columns by 60 rows of `grid_unit`. The tiles named below carry
# only keys from that pane type's closed settings table (pane_types.gd).
LAYOUTS = {
    "showcase": [
        tile(0, 0, 34, 60, type="terminal", pane_name="agent", font_size=FONT),
        # The concept's receiver, already open on a file: an empty viewer's
        # "Prelude" is the first thing a new window shows, and a hero should
        # not open on it.
        tile(34, 0, 26, 30, type="code_viewer", pane_name="viewer", font_size=FONT,
             file_path=home + "/src/main.rs"),
        # The shipped knowledge base, closed last with `pane-view --graph`:
        # the pane that shows the graph without a click.
        tile(34, 30, 26, 30, type="wiki", pane_name="knowledge", vault_path="@knowledge",
             view_mode="preview", open_note="index.md", font_size=FONT),
    ],
    "panes": [
        tile(0, 0, 60, 60, type="terminal", pane_name="agent", font_size=FONT),
    ],
    "agents": [
        tile(0, 0, 60, 60, type="terminal", pane_name="agent", font_size=FONT),
    ],
    "profiles": [
        tile(0, 0, 60, 60, type="terminal", pane_name="agent", font_size=FONT),
    ],
    "concepts": [
        tile(0, 0, 32, 60, type="terminal", pane_name="agent", font_size=FONT),
        tile(32, 0, 28, 60, type="code_viewer", pane_name="viewer", font_size=FONT),
    ],
    "wiki": [
        tile(0, 0, 26, 60, type="terminal", pane_name="agent", font_size=FONT),
        tile(26, 0, 34, 30, type="wiki", pane_name="notes", vault_path=home + "/vault",
             open_note="index.md", view_mode="split", font_size=FONT),
        tile(26, 30, 34, 30, type="wiki", pane_name="graph", vault_path=home + "/vault",
             graph=True, font_size=FONT),
    ],
    "media": [
        tile(0, 0, 36, 60, type="media", pane_name="clip", file_path=home + "/clip.mp4", loop=True),
        tile(36, 0, 24, 60, type="terminal", pane_name="agent", font_size=FONT),
    ],
    "cli-view": [
        tile(0, 0, 60, 60, type="terminal", pane_name="agent", font_size=FONT),
    ],
}
layout = LAYOUTS[scenario]
print(json.dumps({"version": 1, "active": 0,
                  "workspaces": [{"name": "demo", "layout": layout, "grid_unit": 60}]}))
PY

# The terminal font comes from the global setting at spawn, not from the tile.
printf '{"font_size": %s}\n' "${DEMO_FONT:-22}" >"$DATA_DIR/settings.json"

# The vault verbs answer only inside a registered root, and the pane settings UI
# is the registry's only writer (a restored layout cannot register one), so seed
# what a user produces by opening this vault once. Sandbox only.
if [[ "$SCENARIO" == wiki ]]; then
    printf '{"roots": ["%s"]}\n' "$HOME/vault" >"$DATA_DIR/vaults.json"
fi

# ── launch ───────────────────────────────────────────────────────────────
APP_CMD="${DEMO_APP:-godot --path $ROOT/godot --display-driver x11 --windowed --resolution $SIZE}"
(cd "$HOME" && exec $APP_CMD) >"$TMP/app.log" 2>&1 &
APP_PID=$!

WID=""
for _ in $(seq 1 60); do
    WID="$(APP_PID="$APP_PID" python3 - <<'PY' 2>/dev/null
import os
from Xlib import display
pid_want = int(os.environ["APP_PID"])
d = display.Display()
found = []
def walk(w):
    if found:
        return
    try:
        name = (w.get_wm_name() or "").lower()
        if "gpty" in name:
            pid = w.get_full_property(d.intern_atom("_NET_WM_PID"), 0)
            if pid and pid.value[0] in (pid_want,):
                found.append(w.id)
                return
    except Exception:
        pass
    try:
        for c in w.query_tree().children:
            walk(c)
    except Exception:
        pass
walk(d.screen().root)
print(hex(found[0]) if found else "")
PY
)"
    [[ -n "$WID" ]] && break
    sleep 0.5
done
[[ -n "$WID" ]] || { echo "gpty window not found. App log tail:" >&2; tail -20 "$TMP/app.log" >&2; exit 4; }
for _ in $(seq 1 40); do gpty daemon status >/dev/null 2>&1 && break; sleep 0.5; done
sleep 2

# ── record + captions ────────────────────────────────────────────────────
RAW="$TMP/raw.mkv"
ffmpeg -loglevel error -y -f x11grab -framerate "$FPS" -window_id "$WID" -i "$DISPLAY" \
    -vf "scale=trunc(iw/2)*2:trunc(ih/2)*2" -c:v libx264 -preset ultrafast -crf 16 -pix_fmt yuv420p "$RAW" &
REC_PID=$!
T0="$EPOCHREALTIME"
now() { python3 -c "print(round($EPOCHREALTIME - ${T0/,/.}, 2))"; }
CUES="$TMP/cues.tsv"; : >"$CUES"
CUE_N=0; CUE_START=""
cue_end() {
    [[ -n "$CUE_START" ]] || return 0
    printf '%s\t%s\t%s\n' "$CUE_START" "$(now)" "$CUE_N" >>"$CUES"
    CUE_START=""
}
caption() { cue_end; CUE_N=$((CUE_N + 1)); printf '%s' "$1" >"$TMP/cue$CUE_N.txt"; CUE_START="$(now)"; }

label_of() { # label_of <type> -> first pane label of that type (from the live pane list)
    gpty list-panes --json | python3 -c '
import json, sys
want = sys.argv[1]
d = json.load(sys.stdin)
panes = d.get("result", d)
panes = panes.get("panes", panes) if isinstance(panes, dict) else panes
for p in panes:
    if p.get("type") == want or p.get("pane_type") == want:
        print(p.get("label") or p.get("id")); break
' "$1"
}
json_label() { # json_label -> the `label` of a `--json` command result
    python3 -c 'import json,sys; d=json.load(sys.stdin); r=d.get("result", d); print(r.get("label",""))'
}
type_line() { gpty inject "$AGENT" --text "$1" >/dev/null; }
inject_into() { gpty inject "$1" --text "$2" >/dev/null; }

sleep 1.5
# Resolve the pane this script types into before any cue spawns another terminal:
# a later spawn would otherwise move "the first terminal" out from under the run.
AGENT="$(label_of terminal)"
[[ -n "$AGENT" ]] || { echo "no terminal pane found; pane list:" >&2; gpty list-panes >&2; exit 5; }

case "$SCENARIO" in
showcase)
    # Five real gestures and no theatre: nothing prints a string it then
    # "waits for", no JSON document fills the frame (a spawn and a pane-view
    # print one, so their stdout goes to /dev/null - the pane appearing and
    # the canvas changing are the confirmation), and every line fits the pane,
    # because the terminal is 34/60 wide and a wrapped command reads as noise.
    caption "A tiling workspace, not a terminal"
    sleep 2
    caption "Panes are real PTYs"
    type_line "python3 -m unittest -q"
    sleep 3
    caption "A concept routes output into the pane beside it"
    type_line "cat <(git diff)"
    sleep 4
    # `-C $HOME`: a cli_view starts in the app's directory, not the pane's,
    # so an unqualified `git status` reports the gPTY repository itself.
    caption "Any command can own a pane"
    type_line "gpty new-pane -t cli_view -c git --arg=-C --arg \"\$HOME\" --arg=status --title status --split bottom >/dev/null"
    sleep 4
    KB="$(label_of wiki)"
    [[ -n "$KB" ]] || { echo "no wiki pane; pane list:" >&2; gpty list-panes >&2; exit 5; }
    caption "One call opens the shipped knowledge base's link graph"
    type_line "gpty pane-view $KB --graph >/dev/null"
    sleep 4.5
    caption "gPTY - github.com/godot-pty/gpty"
    sleep 2
    ;;
panes)
    caption "One shell, and a grid that splits on demand"
    sleep 2.5
    caption "A second shell splits in beside it"
    FILES="$(gpty new-pane -t terminal --title files --split right --json | json_label)"
    sleep 2.5
    inject_into "$FILES" "ls"
    sleep 2
    caption "and a third below"
    LOG="$(gpty new-pane -t terminal --title log --split bottom --json | json_label)"
    sleep 2.5
    inject_into "$LOG" "git log --oneline --graph"
    sleep 3
    caption "Close one; the grid reflows"
    type_line "gpty kill-pane active"
    sleep 2.5
    caption "gPTY - github.com/godot-pty/gpty"
    sleep 2
    ;;
agents)
    caption "Spawn panes from a script and tag them"
    A="$(gpty new-pane -t terminal --title build-a --tags build --split right --json | json_label)"
    sleep 2.5
    B="$(gpty new-pane -t terminal --title build-b --tags build --split bottom --json | json_label)"
    sleep 2.5
    caption "One broadcast reaches every tagged pane"
    type_line "gpty broadcast --tags build --text 'for i in 1 2 3; do echo \"job \$i\"; sleep 1; done'"
    sleep 4.5
    caption "An agent declares its own state from inside its pane"
    inject_into "$A" "gpty state working"
    sleep 3
    caption "failed and needs-attention are different glyphs, not just colours"
    inject_into "$B" "gpty state failed"
    sleep 1.5
    inject_into "$A" "gpty state needs-attention"
    sleep 3
    caption "The same state is readable over the API"
    type_line "gpty pane-status"
    sleep 3.5
    caption "gPTY - github.com/godot-pty/gpty"
    sleep 2
    ;;
concepts)
    caption "Regex triggers watch a command's output"
    sleep 2.5
    type_line "gpty concept list"
    sleep 3
    caption "Enable one from the CLI"
    type_line "gpty concept toggle git_diff"
    sleep 2.5
    caption "The trigger captures the reply into the adjacent pane"
    type_line "echo '// demo change' >> src/main.rs"
    sleep 1.2
    type_line "git diff"
    sleep 5
    caption "gPTY - github.com/godot-pty/gpty"
    sleep 2
    ;;
wiki)
    caption "Plain Markdown notes: preview, backlinks and the graph"
    sleep 3
    caption "The CLI searches the vault the panes show"
    type_line "gpty vault search \$HOME/vault agent"
    sleep 4
    caption "and reads a note back by path"
    type_line "gpty vault read \$HOME/vault agents.md"
    sleep 4
    caption "gPTY - github.com/godot-pty/gpty"
    sleep 2
    ;;
media)
    caption "Audio and video play in a pane, through a pinned FFmpeg"
    sleep 5
    caption "The terminal beside it keeps working"
    type_line "git log --oneline"
    sleep 3
    caption "gPTY - github.com/godot-pty/gpty"
    sleep 2
    ;;
profiles)
    # Both profiles ship in the binary (`res://profiles.default.json`) and are
    # program-free, so neither needs a running agent: the panes open on their
    # own idle state and `layoutLoad` answers with the toast that names the
    # profile. Recorded at 1200 px because the Agent Workspace is three panes.
    caption "Agent Workspace"
    type_line "gpty layout load 'Agent Workspace'"
    sleep 3.5
    # The load replaced the workspace, and the pane this script types into
    # with it: resolve the new terminal before the next beat.
    AGENT="$(label_of terminal)"
    caption "Knowledge Base"
    type_line "gpty layout load 'Knowledge Base'"
    sleep 3.5
    caption "gPTY - github.com/godot-pty/gpty"
    sleep 2
    ;;
cli-view)
    caption "Stream any command's output into its own pane"
    sleep 2.5
    type_line "gpty new-pane -t cli_view -c git --arg=-C --arg \"\$HOME\" --arg log --arg=--oneline --arg=-5 --title history"
    sleep 4
    caption "argv, not a shell string: the pane runs the program directly"
    type_line "gpty new-pane -t cli_view -c git --arg=-C --arg \"\$HOME\" --arg show --arg=--stat --arg=--oneline --arg=HEAD~3 --title last-commit --split right"
    sleep 4
    caption "gPTY - github.com/godot-pty/gpty"
    sleep 2
    ;;
esac
cue_end
kill -INT "$REC_PID" 2>/dev/null || true
wait "$REC_PID" 2>/dev/null || true
REC_PID=""
[[ -s "$RAW" ]] || { echo "capture produced no video" >&2; exit 6; }

# ── encode ───────────────────────────────────────────────────────────────
FONT="$(fc-match -f '%{file}' 'sans:bold' 2>/dev/null || true)"
DRAW=""
while IFS=$'\t' read -r a b n; do
    DRAW+="drawtext=${FONT:+fontfile=$FONT:}textfile=$TMP/cue$n.txt:fontsize=26:fontcolor=white:box=1:boxcolor=black@0.7:boxborderw=14:${CAPTION_POS:-x=(w-text_w)/2:y=h-text_h-28}:enable='between(t,$a,$b)',"
done <"$CUES"
DRAW="${DRAW%,}"; [[ -n "$DRAW" ]] || DRAW="null"
mkdir -p "$OUT_DIR"
BASE="$OUT_DIR/demo-$SCENARIO"
ffmpeg -loglevel error -y -i "$RAW" -vf "$DRAW" -c:v libx264 -crf 23 -preset slow -pix_fmt yuv420p -movflags +faststart "$BASE.mp4"
ffmpeg -loglevel error -y -i "$RAW" -vf "$DRAW" -c:v libvpx-vp9 -crf 34 -b:v 0 -an "$BASE.webm"
ffmpeg -loglevel error -y -i "$RAW" -vf "$DRAW,fps=$GIF_FPS,scale=$GIF_WIDTH:-1:flags=lanczos,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=4:diff_mode=rectangle" "$BASE.gif"
if [[ "${DEMO_KEEP:-}" == 1 ]]; then cp "$RAW" "$BASE.raw.mkv"; cp "$CUES" "$BASE.cues.tsv"; fi
ls -lh "$BASE".{gif,mp4,webm}
