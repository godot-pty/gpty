#!/usr/bin/env bash
set -euo pipefail

# ── ci-check: Run all CI checks locally in fast-fail order ──────────────
# Usage: ./scripts/ci-check [--fast]
#   --fast   Only fmt + workflow lint + clippy (pre-commit)
#   (no flag)  Full suite: fmt + lint + clippy + tests + GUT + audit
#
# A documentation-only change runs the docs gates only (docs-check +
# knowledge bundle) in either mode, because a Markdown edit cannot change what
# the Rust, GDScript or smoke gates test - and CI skips its code workflow for
# one too (`paths-ignore` in .github/workflows/ci.yml). The changed set is the
# push range when the pre-push hook provides it (CI_CHECK_RANGE_FROM), the
# index under --fast, and the unpushed commits otherwise, always plus
# uncommitted and untracked files. CI_CHECK_FULL=1 forces the full suite.
#
# A missing optional toolchain (node, godot, python3 >= 3.11, cargo-audit)
# SKIPs with a warning on a dev machine, but FAILS the run when the CI or
# GITHUB_ACTIONS environment variable is set: a CI build must not go green
# having run no GDScript tests and no dependency audit.

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

FAST=false
if [[ "${1:-}" == "--fast" ]]; then
    FAST=true
fi

# ── Color helpers ───────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'       # No Color
BOLD='\033[1m'

pass()  { printf "  ${GREEN}PASS${NC} %s\n" "$1"; }
fail()  { printf "  ${RED}FAIL${NC} %s\n" "$1"; }
warn()  { printf "  ${YELLOW}SKIP${NC} %s\n" "$1"; }
header(){ printf "\n${BOLD}── %s ──${NC}\n" "$1"; }
detail(){ printf "%s\n" "$1" | sed 's/^/    /'; }

FAILED=0

check_failed() {
    FAILED=1
    return 1
}

# Missing toolchains are a friendly SKIP on a dev machine, but a green build
# that ran zero GDScript tests on CI. CI is detected via the conventional
# CI / GITHUB_ACTIONS environment variables.
CI_MODE=false
if [[ -n "${CI:-}" || -n "${GITHUB_ACTIONS:-}" ]]; then
    CI_MODE=true
fi

# skip_gate <message>: warn locally, hard-fail in CI.
skip_gate() {
    if $CI_MODE; then
        fail "$1 (CI: a missing gate is a failure)"
        check_failed
    else
        warn "$1"
    fi
}

# ── Mode banner ────────────────────────────────────────────────────────
header "ci-check"
if $CI_MODE; then
    printf "  %bMode: CI%b — a missing toolchain fails the build\n" "$BOLD" "$NC"
else
    printf "  %bMode: local%b — a missing toolchain skips with a warning\n" "$BOLD" "$NC"
fi

# ── Documentation-only changes ─────────────────────────────────────────
# Same globs as ci.yml's `paths-ignore`; keep them in sync. `case` patterns
# match `/`, so `docs/*` covers every depth and `*.md` covers a README next to
# a crate.
changed_paths() {
    {
        if [ -n "${CI_CHECK_RANGE_FROM:-}" ]; then
            git diff --name-only "${CI_CHECK_RANGE_FROM}..HEAD" 2>/dev/null || true
        elif $FAST; then
            git diff --cached --name-only 2>/dev/null || true
        else
            upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
            if [ -n "$upstream" ]; then
                git diff --name-only "${upstream}..HEAD" 2>/dev/null || true
            fi
        fi
        # Whatever is not committed yet is in no committed range, and a new
        # Rust file must not hide behind a docs commit.
        git diff --name-only 2>/dev/null || true
        git diff --cached --name-only 2>/dev/null || true
        git ls-files --others --exclude-standard 2>/dev/null || true
    } | sed '/^$/d' | sort -u
}

docs_only_change() {
    local paths p seen=0
    paths="$(changed_paths)"
    [ -n "$paths" ] || return 1          # nothing to judge: run everything
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        seen=1
        case "$p" in
            docs/*|*.md|godot/knowledge.json|LICENSE) ;;
            *) return 1 ;;
        esac
    done <<EOF
$paths
EOF
    [ "$seen" -eq 1 ]
}

run_docs_check() {
    header "docs-check"
    if DOCS_OUT="$(python3 scripts/docs-check 2>&1)"; then
        pass "docs-check"
    else
        fail "docs-check"
        detail "$DOCS_OUT"
        check_failed
    fi
}

run_bundle_check() {
    header "knowledge bundle"
    if WIKI_OUT="$(python3 scripts/build-wiki --check 2>&1)"; then
        pass "knowledge bundle"
    else
        fail "knowledge bundle"
        detail "$WIKI_OUT"
        check_failed
    fi
}

if ! $CI_MODE && [ -z "${CI_CHECK_FULL:-}" ] && docs_only_change; then
    printf "  %bDocs-only change%b — docs gates only; CI_CHECK_FULL=1 runs everything\n" "$BOLD" "$NC"
    run_docs_check
    run_bundle_check
    printf "\n"
    if [[ $FAILED -eq 0 ]]; then
        printf "${GREEN}${BOLD}Docs checks passed. Ready to push.${NC}\n"
    else
        printf "${RED}${BOLD}Docs checks failed. Fix before pushing.${NC}\n"
    fi
    exit $FAILED
fi

# ── Media dependencies (before anything compiles the extension) ────────
# The GDExtension links FFmpeg, and the pinned build is what CI tests. Build
# it once per prefix (scripts/media-deps caches by version + component hash);
# a developer with system FFmpeg can still run, but the pinned prefix keeps
# the local gate equal to CI.
case "$(uname -s)" in
    Linux*) MEDIA_PLATFORM="linux" ;;
    Darwin*) MEDIA_PLATFORM="macos" ;;
    MINGW*|MSYS*|CYGWIN*) MEDIA_PLATFORM="windows" ;;
    *) MEDIA_PLATFORM="unknown" ;;
esac
case "$(uname -m)" in
    amd64|x86_64) MEDIA_ARCH="x86_64" ;;
    arm64|aarch64) MEDIA_ARCH="arm64" ;;
    *) MEDIA_ARCH="unknown" ;;
esac
MEDIA_ENV="$REPO_ROOT/dist/ffmpeg/$MEDIA_PLATFORM-$MEDIA_ARCH/env.sh"
header "media dependencies"
# The script is a no-op when the stamp matches (version + components + asm);
# running it unconditionally is what notices a changed component list.
if "$REPO_ROOT/scripts/media-deps"; then
    pass "media dependencies"
else
    fail "media dependencies — run './scripts/media-deps'"
    check_failed
    # Let the checks below fail with the real compiler error if the system
    # FFmpeg can satisfy them; the gate already recorded failure.
fi
if [ -f "$MEDIA_ENV" ]; then
    # shellcheck disable=SC1090
    source "$MEDIA_ENV"
fi

# ── Step 1: cargo fmt ──────────────────────────────────────────────────
header "cargo fmt --check"
if cargo fmt --all -- --check 2>&1; then
    pass "rustfmt"
else
    fail "rustfmt — run 'cargo fmt --all' to fix"
    check_failed
fi

# ── Step 2: Workflow YAML lint ─────────────────────────────────────────
header "workflow YAML lint"
if YAML_OUT="$(./scripts/lint-workflows 2>&1)"; then
    pass "workflow lint"
else
    fail "workflow lint"
    detail "$YAML_OUT"
    check_failed
fi

# ── Docs: markdown links, roadmap tables, split pages ──────────────────
run_docs_check

# ── MCP registry descriptor ────────────────────────────────────────────
# server.json is the claim the registry publishes: the package it names, the
# version it pins and the arguments that start the server. A typo that the
# registry only rejects at release time fails here instead.
header "mcp-registry"
if MCP_OUT="$(python3 scripts/mcp-registry check 2>&1)"; then
    pass "mcp-registry"
else
    fail "mcp-registry"
    detail "$MCP_OUT"
    check_failed
fi

# ── Knowledge bundle: generated from the wiki vault ────────────────────
# The vault is the source; godot/knowledge.json is what release builds read.
# A stale bundle ships old notes, so it fails here rather than at export.
run_bundle_check

# ── Step 3: cargo clippy ───────────────────────────────────────────────
header "cargo clippy"
if cargo clippy --workspace -- -D warnings 2>&1; then
    pass "clippy"
else
    fail "clippy"
    check_failed
fi

# ── Step 3.1: GDExtension surface ──────────────────────────────────────
# A renamed or removed #[func] does not fail at GDScript parse time: the call
# breaks at runtime, in whichever pane exercises it, often visible only in a
# log line. This cross-checks every GDScript call on a GDExtension handle
# against the exported surface (name and arity). Static, no build.
header "GDExtension surface"
if ./scripts/check-ffi-surface 2>&1; then
    pass "GDExtension surface"
else
    fail "GDExtension surface — a GDScript call does not match any #[func]"
    check_failed
fi

# ── Fast mode stops here ───────────────────────────────────────────────
if $FAST; then
    printf "\n"
    if [[ $FAILED -eq 0 ]]; then
        printf "${GREEN}${BOLD}All fast checks passed.${NC}\n"
    else
        printf "${RED}${BOLD}Fast checks failed.${NC}\n"
    fi
    exit $FAILED
fi

# ── Step 3.5: Windows cross-check ─────────────────────────────────────
# Release parity check: release.yml builds on windows-latest; CI job
# rust-windows enforces this in the cloud. Locally it runs when the
# toolchain is available, otherwise it is skipped with a hint. Mirrors
# the CI job's RUSTFLAGS=-Dwarnings so Windows-only dead code fails here
# too instead of surfacing first on GitHub.
header "windows cross-check"
WIN_TARGET="x86_64-pc-windows-msvc"
WIN_OK=true
if rustup target list --installed 2>/dev/null | grep -q "^${WIN_TARGET}$" \
    && command -v clang-cl >/dev/null 2>&1 \
    && command -v llvm-lib >/dev/null 2>&1 \
    && [ -d "$HOME/.xwin/crt" ]; then
    XWIN_CC="$HOME/.local/bin/xwin-clang-cl"
    if [ ! -x "$XWIN_CC" ]; then
        printf '#!/bin/sh\nexec clang-cl --target=x86_64-pc-windows-msvc "$@"\n' > "$XWIN_CC"
        chmod +x "$XWIN_CC"
    fi
    XWIN_INCLUDE="$HOME/.xwin/crt/include;$HOME/.xwin/sdk/include/ucrt;$HOME/.xwin/sdk/include/um;$HOME/.xwin/sdk/include/shared"
    XWIN_LIB="$HOME/.xwin/crt/lib/x86_64;$HOME/.xwin/sdk/lib/ucrt/x86_64;$HOME/.xwin/sdk/lib/um/x86_64"
    if CC_x86_64_pc_windows_msvc="$XWIN_CC" \
        CXX_x86_64_pc_windows_msvc="$XWIN_CC" \
        AR_x86_64_pc_windows_msvc="llvm-lib" \
        INCLUDE="$XWIN_INCLUDE" \
        LIB="$XWIN_LIB" \
        RUSTFLAGS="-Dwarnings" \
        cargo check --workspace --target "$WIN_TARGET" 2>&1; then
        pass "windows cross-check"
    else
        fail "windows cross-check"
        check_failed
    fi
else
    warn "windows cross-check — needs: rustup target add ${WIN_TARGET}; clang-cl + llvm-lib; xwin splat into ~/.xwin (enforced by CI job rust-windows)"
fi
# ── Step 3.7: peer-credential cross-check (BSD) ────────────────────────
# The peer-credential functions are selected by `cfg(target_os)`, so the arms
# for a platform this machine does not build never compile here: a typo in the
# BSD arm would only surface for someone building on FreeBSD. FreeBSD is the
# one that can be checked this way — illumos and NetBSD fail earlier, in the
# bundled-SQLite build script, so those two arms are probe-verified (see the
# ROADMAP entry).
header "BSD cross-check"
BSD_TARGET="x86_64-unknown-freebsd"
if rustup target list --installed 2>/dev/null | grep -q "^${BSD_TARGET}$"; then
    if cargo check -p gpty-ipc --target "$BSD_TARGET" 2>&1; then
        pass "BSD cross-check"
    else
        fail "BSD cross-check"
        check_failed
    fi
else
    warn "BSD cross-check — needs: rustup target add ${BSD_TARGET} (enforced by the rust-tests CI job)"
fi

# ── Step 3.6: uniform crate versions ───────────────────────────────────
# Release convention: every workspace crate ships the same version
# (release skill step 5). One stale manifest = forgotten bump.
header "crate versions"
if python3 -c 'import tomllib' 2>/dev/null; then
    if python3 - <<'EOF' 2>&1
import glob, tomllib
versions = {}
for path in sorted(glob.glob("crates/*/Cargo.toml")):
    with open(path, "rb") as fh:
        data = tomllib.load(fh)
    versions[data["package"]["name"]] = data["package"]["version"]
distinct = sorted(set(versions.values()))
print("  " + ", ".join(f"{name}={ver}" for name, ver in versions.items()))
raise SystemExit(0 if len(distinct) == 1 else 1)
EOF
    then
        pass "crate versions uniform"
    else
        fail "crate versions differ — bump every crates/*/Cargo.toml to the same version"
        check_failed
    fi
else
    skip_gate "crate version check needs python3 >= 3.11 (tomllib) — skipped"
fi

# ── Step 4: cargo test ─────────────────────────────────────────────────
header "cargo test"
if cargo test --workspace -- --test-threads=1 2>&1; then
    pass "cargo test"
else
    fail "cargo test"
    check_failed
fi

# ── Step 4.2: Rust tests, default parallelism ─────────────────────────
# The serial pass above is the gate; this one catches tests that only pass
# because nothing else runs at the same time (shared statics, fixed paths,
# files in a shared temp dir). A bug of exactly that kind — one module's
# queue tests clearing state another module was using — stayed invisible
# for as long as the suite was only ever run serialised.
header "cargo test (parallel)"
if cargo test --workspace 2>&1; then
    pass "cargo test (parallel)"
else
    fail "cargo test (parallel) — the suite must also pass with default parallelism"
    check_failed
fi

# ── Step 4.5: OMP extension tests ──────────────────────────────────────
header "OMP extension tests"
if command -v node >/dev/null 2>&1; then
    if (cd extensions/gpty-omp-events && node --test) 2>&1; then
        pass "gpty-omp-events"
    else
        fail "gpty-omp-events"
        check_failed
    fi
else
    skip_gate "node not found — skipping OMP extension tests"
fi

# ── Step 5: GUT (GDScript) tests ───────────────────────────────────────
header "GUT tests"
GODOT="$(command -v godot 2>/dev/null || echo "")"
if [[ -z "$GODOT" ]]; then
    skip_gate "godot not found — skipping GUT tests"
else
    echo "  Building GDExtension..."
    cargo build -p gpty-gdext 2>&1 || { fail "gdext build"; check_failed; }
    echo "  Installing GDExtension library..."
    mkdir -p godot/bin
    ln -sf ../../target/debug/libgpty_gdext.so godot/bin/libgpty_gdext.linux.x86_64.so 2>&1 || {
        fail "link libgpty_gdext.so — check target path"
        check_failed
    }
    echo "  Importing Godot project..."
    godot --headless --path godot --import 2>&1 || { fail "godot import"; check_failed; }
    echo "  Running GUT tests..."
    # gut-check owns the GUT command and validates the run (a parse error makes
    # GUT abort after a handful of scripts and still exit 0).
    if GODOT="$GODOT" ./scripts/gut-check 2>&1; then
        pass "GUT tests"
    else
        fail "GUT tests"
        check_failed
    fi
fi

# ── Step 5.5: Live pane-API smoke ─────────────────────────────────────
header "pane-API smoke"
if [[ -z "$GODOT" ]]; then
    skip_gate "godot not found — skipping smoke test"
elif ! command -v python3 >/dev/null 2>&1; then
    skip_gate "python3 not found — skipping smoke test"
else
    echo "  Running live pane-API smoke (headless GUI)..."
    # One harness for every platform: it drives the same flow through a Unix
    # socket here and a named pipe on Windows (see the windows-smoke CI job).
    if GODOT="$GODOT" python3 ./scripts/smoke_pane_api.py 2>&1; then
        pass "pane-API smoke"
    else
        fail "pane-API smoke"
        check_failed
    fi
fi

# ── Step 6: cargo audit ────────────────────────────────────────────────
header "cargo audit"

if command -v cargo-audit &>/dev/null; then
    # cargo-audit needs a lockfile with exact versions; create one only if
    # missing. Never regenerate over an existing file: generate-lockfile
    # re-resolves to latest compatible versions and silently rewrites the
    # repo's pinned Cargo.lock on every run.
    [ -f Cargo.lock ] || cargo generate-lockfile 2>&1 || true
    # Same flags as CI (.github/workflows/ci.yml). `--deny warnings` matters:
    # plain `cargo audit` reports an `unsound` advisory as an allowed warning
    # and exits 0, so this gate passed on the change that turned CI red
    # (RUSTSEC-2026-0386, tokio). A warning CI would reject must fail here too.
    if cargo audit --deny warnings 2>&1; then
        pass "cargo audit"
    else
        fail "cargo audit"
        check_failed
    fi
else
    skip_gate "cargo-audit not installed — run: cargo install cargo-audit"
fi

# ── Summary ────────────────────────────────────────────────────────────
printf "\n"
if [[ $FAILED -eq 0 ]]; then
    printf "${GREEN}${BOLD}All checks passed. Ready to push.${NC}\n"
else
    printf "${RED}${BOLD}Some checks failed. Fix before pushing.${NC}\n"
fi
exit $FAILED
