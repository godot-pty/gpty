#!/usr/bin/env bash
# Refuse high-confidence secret formats in the git index.
#
# The index is what a commit will contain, so this is the pre-commit gate as
# well as a static gate in ci-check. It is deliberately narrow: a handful of
# well-known credential formats with no false positives in this tree. The
# full-history scan is gitleaks in .github/workflows/secret-scan.yml.
#
# Usage: scripts/check-secrets [--root DIR]   (DIR defaults to this repo)
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

usage() {
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
}

ROOT=""
case "${1:-}" in
    -h | --help)
        usage
        exit 0
        ;;
    --root)
        [ $# -ge 2 ] || { echo "check-secrets: --root needs a directory" >&2; usage >&2; exit 2; }
        ROOT=$2
        ;;
    --root=*)
        ROOT=${1#*=}
        ;;
    "")
        ;;
    *)
        echo "check-secrets: unknown argument '$1'" >&2
        usage >&2
        exit 2
        ;;
esac
if [ -n "$ROOT" ]; then
    git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 \
        || { echo "check-secrets: $ROOT is not a git work tree" >&2; exit 2; }
    cd "$ROOT"
fi

# `regex|name`; the name is printed, the matched text is not.
RULES=(
  '-----BEGIN ([A-Z0-9]+ )?PRIVATE KEY-----|private key block'
  'AKIA[0-9A-Z]{16}|AWS access key id'
  'ASIA[0-9A-Z]{16}|AWS temporary access key id'
  'gh[pousr]_[A-Za-z0-9]{36,}|GitHub token'
  'github_pat_[A-Za-z0-9_]{50,}|GitHub fine-grained token'
  'xox[abposr]-[A-Za-z0-9-]{10,}|Slack token'
  'AIza[0-9A-Za-z_-]{35}|Google API key'
  'sk_live_[0-9A-Za-z]{16,}|Stripe live secret key'
)

status=0
for rule in "${RULES[@]}"; do
  regex=${rule%%|*}
  name=${rule#*|}
  if out=$(git grep --cached -nI -E -e "$regex" -- . \
      ':(exclude)godot/addons/**' \
      ':(exclude)docs/static/**' \
      ':(exclude).entire/**' 2>/dev/null); then
    while IFS=: read -r file line _; do
      printf 'check-secrets: %s:%s: possible %s\n' "$file" "$line" "$name"
    done <<< "$out"
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  printf '%s\n' "Refusing to continue: remove the value or add a narrowly scoped allowlist entry in scripts/check-secrets with a comment." >&2
fi
exit "$status"
