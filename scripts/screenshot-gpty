#!/usr/bin/env bash
# Capture a screenshot of a running gpty app window.
#
# Launches the app in a private sandbox (fresh user data, HOME, runtime dir and
# control socket — see scripts/ui-sandbox), finds its window on the X server
# (XWayland), waits for first frames, captures it with ImageMagick, and tears
# everything down.
#
# Usage: scripts/screenshot-gpty <output.png> <app-command...>
#        scripts/screenshot-gpty <output.png> --state <name> <app-command...>
#   e.g. scripts/screenshot-gpty docs/static/images/v0.5.1_1.png godot --path godot
#
# `--state <name>` stages a committed UI state through
# godot/tests/bench/ui_capture.gd before the grab (scripts/ui-capture --list
# prints the names): the harness keeps the window open and reports the state
# ready, and only then is the window captured. The app command must accept
# Godot's `-s <script>` — pass the Godot binary with `--path godot`. For an
# audit PNG of the app's own viewport rather than the desktop window, use
# scripts/ui-capture directly; this script is for release/blog images, where
# the window itself is the point.
#
# SCREENSHOT_WAIT=<seconds> (default 2) is how long to let the window settle
# after it appears (or after `--state` reports ready) before the capture.
# Raise it when the frame to capture takes longer to arrive than a plain
# startup — a test-driven UI state, a slow machine.
#
# Requires: ffmpeg (preferred, `x11grab -window_id`) or an ImageMagick built
# with X11 support (`import -window`), python3 + python-xlib, and a graphical
# session with XWayland (DISPLAY set). Used by the release skill.
set -euo pipefail

OUT="${1:?output path}"
shift
STATE=""
if [[ "${1:-}" == "--state" ]]; then
    STATE="${2:?--state needs a value}"
    shift 2
fi
[[ $# -ge 1 ]] || {
    echo "usage: screenshot-gpty <out.png> [--state <name>] <app-command...>" >&2
    exit 2
}

command -v python3 >/dev/null || { echo "missing tool: python3 (need python3-xlib)" >&2; exit 3; }
CAPTURE=""
if command -v ffmpeg >/dev/null; then
    CAPTURE=ffmpeg
elif command -v import >/dev/null; then
    # An ImageMagick built without X11 fails at capture time with a
    # "missing an image filename" error that names the output path.
    CAPTURE=import
else
    echo "missing tool: ffmpeg or imagemagick (import)" >&2
    exit 3
fi
[[ -n "${DISPLAY:-}" ]] || { echo "no DISPLAY — the app window must exist on X11/XWayland" >&2; exit 3; }

. "$(dirname "${BASH_SOURCE[0]}")/ui-sandbox"
gpty_sandbox_init
TMP="$GPTY_SANDBOX"
APP_PID=""
cleanup() {
    [[ -n "$APP_PID" ]] && kill "$APP_PID" 2>/dev/null || true
    [[ -n "$APP_PID" ]] && wait "$APP_PID" 2>/dev/null || true
    gpty_sandbox_cleanup
}
trap cleanup EXIT

READY=""
CMD=("$@")
if [[ -n "$STATE" ]]; then
    for arg in "$@"; do
        case "$arg" in
            -s | --script | --)
                echo "--state cannot be combined with a command that already passes $arg" >&2
                exit 2
                ;;
        esac
    done
    READY="$TMP/ui-ready"
    CMD+=(--disable-vsync -s res://tests/bench/ui_capture.gd -- --state "$STATE" --hold --ready "$READY")
fi
"${CMD[@]}" >"$TMP/app.log" 2>&1 &
APP_PID=$!

WID=""
for _ in $(seq 1 40); do
    WID="$(APP_PID="$APP_PID" python3 - <<'PY' 2>/dev/null
import os, sys
from Xlib import display
target_pid = int(os.environ["APP_PID"])
d = display.Display()
root = d.screen().root
found = [None]
def walk(w):
    if found[0]:
        return
    try:
        name = w.get_wm_name()
    except Exception:
        name = None
    if name and "gpty" in (name or "").lower():
        try:
            pid = w.get_full_property(d.intern_atom("_NET_WM_PID"), 0)
            if pid and pid.value[0] == target_pid:
                found[0] = w.id
                return
        except Exception:
            pass
    try:
        for c in w.query_tree().children:
            walk(c)
    except Exception:
        pass
walk(root)
print(hex(found[0]) if found[0] else "")
PY
)"
    [[ -n "$WID" ]] && break
    # A staging failure exits the app; do not spend the full window wait on a
    # process that is already gone.
    kill -0 "$APP_PID" 2>/dev/null || break
    sleep 0.5
done

[[ -n "$WID" ]] || {
    echo "gpty window not found (XWayland required). App log tail:" >&2
    tail -20 "$TMP/app.log" >&2
    exit 4
}

# The window exists before the state is staged: the driver has to restore the
# workspace, wait for the panes and drain its toasts. Capturing now would grab
# whatever frame the staging happened to be on.
if [[ -n "$READY" ]]; then
    for _ in $(seq 1 120); do
        [[ -f "$READY" ]] && break
        kill -0 "$APP_PID" 2>/dev/null || break
        sleep 0.5
    done
    [[ -f "$READY" ]] || {
        echo "state '$STATE' did not stage within 60 s. App log tail:" >&2
        tail -20 "$TMP/app.log" >&2
        exit 6
    }
fi

sleep "${SCREENSHOT_WAIT:-2}"  # let the first frames settle (SCREENSHOT_WAIT raises it)
case "$CAPTURE" in
    ffmpeg) ffmpeg -y -loglevel error -f x11grab -window_id "$WID" -i "${DISPLAY:-:0}" -frames:v 1 "$OUT" ;;
    import) import -window "$WID" "$OUT" ;;
esac
[[ -s "$OUT" ]] || { echo "capture produced no image (${CAPTURE})" >&2; exit 5; }
echo "captured: $OUT (${CAPTURE})"
