#!/usr/bin/env bash
# Print the CI changed-path class bits for a diff.
#
#   BASE=<commit> HEAD=<commit> ./scripts/ci-changes >> "$GITHUB_OUTPUT"
#
# Four `key=value` lines (rust, godot, node, macos) ready for the `changes`
# job's outputs; the reason line goes to stderr so the job log keeps it. A
# missing base or a diff git cannot compute prints all true - a tree whose
# class is unknown runs the full matrix rather than skipping it. A merge-queue
# group passes its event's base_sha/head_sha exactly as a pull request passes
# its base/head, so the group's own diff decides the matrix. A diff that edits
# the classifier inputs (`ci-classes.env`, `classify-changes`, `ci-changes`)
# prints all true: a classifier edit always pays the full matrix rather than
# classifying itself (BUILD-148).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

usage() {
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
    -h | --help)
        usage
        exit 0
        ;;
    "")
        ;;
    *)
        echo "ci-changes: unknown option '$1'" >&2
        usage >&2
        exit 2
        ;;
esac

all_true() {
    printf 'rust=true\ngodot=true\nnode=true\nmacos=true\n'
    printf 'ci-changes: %s; running the full matrix\n' "$1" >&2
}

base="${BASE:-}"
head="${HEAD:-}"
if [ -z "$base" ] || [[ "$base" =~ ^0+$ ]]; then
    all_true "no base commit"
    exit 0
fi
changed="$(mktemp "${TMPDIR:-/tmp}/gpty-changes.XXXXXX")"
trap 'rm -f "$changed"' EXIT
if ! git diff --name-only "$base" "$head" >"$changed"; then
    all_true "cannot diff $base..$head"
    exit 0
fi
classifier="$(grep -m1 -E '^scripts/(ci-classes\.env|classify-changes|ci-changes)$' "$changed" || true)"
if [ -n "$classifier" ]; then
    all_true "the diff edits $classifier"
    exit 0
fi
printf 'ci-changes: %s changed file(s) in %s..%s\n' \
    "$(wc -l <"$changed")" "$base" "$head" >&2
./scripts/classify-changes <"$changed"
