#!/usr/bin/env python3
"""Read back the repository policy that is not stored in git.

Usage: scripts/check-github-settings [--repo OWNER/REPO] [--reviewer LOGIN]

Rulesets, classic branch protection, the `release` environment and the
repository's Actions/sign-off flags live in the GitHub API, not in a file a
review can diff. This check reads them through `gh api` and fails when the
expected policy has drifted. It is deliberately read-only: it never creates,
updates or deletes anything.

Run it before a release and after changing a ruleset or the release
environment. It needs a maintainer-authenticated `gh` with admin read access;
it is not part of CI because the normal Actions token cannot read rulesets.

The required contexts are the aggregate `ci-gate`, the four CodeQL analysis
jobs (`Analyze (…)`) and Secret scan, not one context per CI job; the code
scanning summary `CodeQL` check is emitted on pull requests but not on
merge-group heads, so requiring it would leave the queue waiting forever. The
merge queue is the up-to-date guarantee that replaced the strict
"branches must be up to date" setting. The `release branch protection` ruleset
covers `refs/heads/release/v*` with a pull request, a review and signed
commits, but no required-check list (the archived trees carry different job
sets). When a job is added or renamed, update `ci-gate`'s needs list; when the
gate context or the queue parameters change, update this file in the same
change.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys

# Code scanning's summary `CodeQL` check reports on pull_request, not on
# merge_group, so requiring it would hang the queue. The four analysis jobs
# report on both events and are the checks to require.
MAIN_CHECKS = [
    "Analyze (actions)",
    "Analyze (javascript-typescript)",
    "Analyze (python)",
    "Analyze (rust)",
    "ci-gate",
    "secret-scan",
]
# Classic protection predates the ruleset and does not carry secret-scan.
CLASSIC_CHECKS = [name for name in MAIN_CHECKS if name != "secret-scan"]

MAIN_RULES = {
    "deletion",
    "non_fast_forward",
    "required_signatures",
    "pull_request",
    "required_status_checks",
    "merge_queue",
}
# A release branch keeps a pull request, a review and signed commits. It does
# not carry a required-check list: the archived lines run different job sets
# (v0.3.2 had 6 CI jobs, v0.7.2 had 10, the trunk has 14), so one fixed list
# would leave every old-line PR waiting on a context that tree cannot produce.
# Their CI still runs on pull requests, and RELEASING.md requires it green.
RELEASE_RULES = {"deletion", "non_fast_forward", "required_signatures", "pull_request"}
# `creation` is deliberately absent: it restricts ref creation to bypass actors, and this
# ruleset has none, so a tag could never be pushed at all. Signatures protect a tag; the
# update/deletion rules keep a bad one from being repaired or removed.
TAG_RULES = {"update", "deletion", "non_fast_forward", "required_signatures"}


class ApiError(RuntimeError):
    pass


def gh(*args: str) -> str:
    try:
        proc = subprocess.run(
            ["gh", *args],
            check=False,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError as exc:
        raise ApiError("the `gh` CLI is not installed") from exc
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        raise ApiError(f"gh {' '.join(args)} failed: {detail}")
    return proc.stdout


def api(repo: str, path: str = ""):
    """GET an API path; `gh api` uses GET unless told otherwise."""
    endpoint = f"repos/{repo}" if not path else f"repos/{repo}/{path}"
    raw = gh("api", endpoint)
    try:
        return json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ApiError(f"repos/{repo}/{path} did not return JSON") from exc


def default_repo() -> str:
    if env := os.environ.get("GH_REPO"):
        return env
    try:
        return gh("repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner").strip()
    except ApiError as exc:
        raise ApiError(
            "cannot determine the repository; pass --repo OWNER/REPO or set GH_REPO"
        ) from exc


def params(rule: dict | None) -> dict:
    return (rule or {}).get("parameters") or {}


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Check the repository rulesets, release environment and Actions policy.",
    )
    parser.add_argument(
        "--repo",
        default=None,
        help="owner/repo (default: gh repo view's nameWithOwner, or GH_REPO)",
    )
    parser.add_argument(
        "--reviewer",
        default=os.environ.get("GPTY_RELEASE_REVIEWER", "1nv1n"),
        help="expected required reviewer for the release environment (default: 1nv1n)",
    )
    args = parser.parse_args()

    try:
        repo = args.repo or default_repo()
        rulesets = api(repo, "rulesets")
        by_name = {item["name"]: item["id"] for item in rulesets}
        missing = {"main protection", "release branch protection", "tag"} - set(by_name)
        if missing:
            raise ApiError(f"missing ruleset(s): {', '.join(sorted(missing))}")

        main = api(repo, f"rulesets/{by_name['main protection']}")
        release = api(repo, f"rulesets/{by_name['release branch protection']}")
        tag = api(repo, f"rulesets/{by_name['tag']}")
        classic = api(repo, "branches/main/protection")
        environment = api(repo, "environments/release")
        actions = api(repo, "actions/permissions")
        repo_info = api(repo, "")
    except ApiError as exc:
        print(f"check-github-settings: {exc}", file=sys.stderr)
        return 2

    failures: list[str] = []

    def check(label: str, ok: bool, detail: str = "") -> None:
        if ok:
            print(f"ok   {label}")
            return
        print(f"FAIL {label}" + (f" ({detail})" if detail else ""))
        failures.append(label)

    def equal(label: str, actual, expected) -> None:
        check(label, actual == expected, f"expected {expected!r}, got {actual!r}")

    def rules(rs: dict) -> dict[str, dict]:
        return {rule["type"]: rule for rule in rs.get("rules", [])}

    # ── main protection ────────────────────────────────────────────────
    check("main: target is branch", main.get("target") == "branch", repr(main.get("target")))
    check("main: enforcement active", main.get("enforcement") == "active", repr(main.get("enforcement")))
    equal("main: no bypass actors", main.get("bypass_actors"), [])
    equal(
        "main: covers the default branch",
        main.get("conditions", {}).get("ref_name", {}),
        {"include": ["~DEFAULT_BRANCH"], "exclude": []},
    )
    main_rules = rules(main)
    equal("main: rule types", set(main_rules), MAIN_RULES)
    check("main: signed commits", "required_signatures" in main_rules)
    pr = params(main_rules.get("pull_request"))
    equal("main: merge commits only", pr.get("allowed_merge_methods"), ["merge"])
    equal("main: one approving review", pr.get("required_approving_review_count"), 1)
    check("main: code-owner review", pr.get("require_code_owner_review") is True)
    check("main: last-push approval", pr.get("require_last_push_approval") is True)
    check("main: stale reviews dismissed", pr.get("dismiss_stale_reviews_on_push") is True)
    check(
        "main: review threads resolved",
        pr.get("required_review_thread_resolution") is True,
    )
    checks = params(main_rules.get("required_status_checks"))
    contexts = sorted(item["context"] for item in checks.get("required_status_checks", []))
    equal("main: required checks", contexts, sorted(MAIN_CHECKS))
    check(
        "main: strict required checks",
        checks.get("strict_required_status_checks_policy") is False,
    )
    queue = params(main_rules.get("merge_queue"))
    equal("main: merge queue method", queue.get("merge_method"), "MERGE")
    equal("main: merge queue grouping", queue.get("grouping_strategy"), "ALLGREEN")
    equal("main: merge queue build cap", queue.get("max_entries_to_build"), 5)
    equal("main: merge queue merge cap", queue.get("max_entries_to_merge"), 5)
    equal("main: merge queue minimum", queue.get("min_entries_to_merge"), 1)
    equal("main: merge queue wait", queue.get("min_entries_to_merge_wait_minutes"), 5)

    # ── release branch protection ──────────────────────────────────────
    check(
        "release: target is branch",
        release.get("target") == "branch",
        repr(release.get("target")),
    )
    check(
        "release: enforcement active",
        release.get("enforcement") == "active",
        repr(release.get("enforcement")),
    )
    equal("release: no bypass actors", release.get("bypass_actors"), [])
    equal(
        "release: covers release/v* branches",
        release.get("conditions", {}).get("ref_name", {}),
        {"include": ["refs/heads/release/v*"], "exclude": []},
    )
    release_rules = rules(release)
    equal("release: rule types", set(release_rules), RELEASE_RULES)
    check("release: signed commits", "required_signatures" in release_rules)
    release_pr = params(release_rules.get("pull_request"))
    equal("release: merge commits only", release_pr.get("allowed_merge_methods"), ["merge"])
    equal("release: one approving review", release_pr.get("required_approving_review_count"), 1)
    check("release: code-owner review", release_pr.get("require_code_owner_review") is True)
    check("release: last-push approval", release_pr.get("require_last_push_approval") is True)
    check(
        "release: stale reviews dismissed",
        release_pr.get("dismiss_stale_reviews_on_push") is True,
    )
    check(
        "release: review threads resolved",
        release_pr.get("required_review_thread_resolution") is True,
    )
    check(
        "release: extra approval for unattributed commits",
        release_pr.get("require_extra_approval_for_unattributed_changes") is True,
    )
    check("release: no required status checks", "required_status_checks" not in release_rules)

    # ── tag protection ─────────────────────────────────────────────────
    check("tag: target is tag", tag.get("target") == "tag", repr(tag.get("target")))
    check("tag: enforcement active", tag.get("enforcement") == "active", repr(tag.get("enforcement")))
    equal("tag: no bypass actors", tag.get("bypass_actors"), [])
    equal(
        "tag: covers all tags",
        tag.get("conditions", {}).get("ref_name", {}),
        {"include": ["~ALL"], "exclude": []},
    )
    equal("tag: rule types", set(rules(tag)), TAG_RULES)

    # ── classic protection (required signatures, admins, contexts) ─────
    check("main classic: admins enforced", classic.get("enforce_admins", {}).get("enabled") is True)
    check(
        "main classic: signed commits",
        classic.get("required_signatures", {}).get("enabled") is True,
    )
    check(
        "main classic: force pushes denied",
        classic.get("allow_force_pushes", {}).get("enabled") is False,
    )
    check(
        "main classic: deletions denied",
        classic.get("allow_deletions", {}).get("enabled") is False,
    )
    reviews = classic.get("required_pull_request_reviews") or {}
    check("main classic: one approving review", reviews.get("required_approving_review_count") == 1)
    check("main classic: code-owner review", reviews.get("require_code_owner_reviews") is True)
    check("main classic: last-push approval", reviews.get("require_last_push_approval") is True)
    check("main classic: stale reviews dismissed", reviews.get("dismiss_stale_reviews") is True)
    status = classic.get("required_status_checks") or {}
    equal("main classic: required checks", sorted(status.get("contexts", [])), sorted(CLASSIC_CHECKS))
    check("main classic: strict required checks", status.get("strict") is False)

    # ── release environment ───────────────────────────────────────────
    review_rules = [
        rule
        for rule in environment.get("protection_rules", [])
        if rule.get("type") == "required_reviewers"
    ]
    reviewers = {
        reviewer.get("reviewer", {}).get("login")
        for rule in review_rules
        for reviewer in rule.get("reviewers", [])
    }
    check(
        "release: required reviewer",
        args.reviewer in reviewers,
        f"expected {args.reviewer!r}, got {sorted(reviewers)}",
    )
    check(
        "release: self-review allowed (the reviewer is the maintainer)",
        all(rule.get("prevent_self_review") is False for rule in review_rules),
    )
    equal("release: no deployment branch policy", environment.get("deployment_branch_policy"), None)

    # ── repository and Actions policy ─────────────────────────────────
    check("actions: enabled", actions.get("enabled") is True)
    check("actions: all actions allowed", actions.get("allowed_actions") == "all")
    check("actions: SHA pinning required", actions.get("sha_pinning_required") is True)
    check("repository: web sign-off required", repo_info.get("web_commit_signoff_required") is True)
    check("repository: default branch is main", repo_info.get("default_branch") == "main")
    check("repository: auto-merge enabled", repo_info.get("allow_auto_merge") is True)
    check("repository: head branches deleted on merge", repo_info.get("delete_branch_on_merge") is True)
    check("repository: merge commits allowed", repo_info.get("allow_merge_commit") is True)

    if failures:
        print(f"check-github-settings: {len(failures)} check(s) failed", file=sys.stderr)
        return 1
    print("check-github-settings: OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
