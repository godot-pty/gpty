#!/usr/bin/env bash
# Lint the GitHub workflows: valid YAML, an explicit least-privilege
# `permissions:` block, SHA-pinned actions, no persisted checkout credentials,
# no dangerous triggers, a timeout on every job (except a job that calls a
# reusable workflow, where GitHub does not accept the keyword) and a
# concurrency group on every workflow.
#
# Why the permission rule: a workflow without one hands every job whatever the
# repository default grants, which is read-write on repositories created before
# February 2023 and follows a transferred or forked repository. GitHub's code
# scanning reports exactly that ("Workflow does not contain permissions"), and a
# green CI run says nothing about it - release.yml shipped that way until
# 2026-10-24. A job that needs more declares its own block, which replaces the
# workflow's scope for that job; the top-level read is the floor, not the
# ceiling (see publish in release.yml).
#
# The pinning rule is the repository's supply-chain floor: a tag is mutable,
# the commit SHA is the pin. `persist-credentials: false` keeps the checkout
# token out of the build's git config; `timeout-minutes` and `concurrency` keep
# a stuck or superseded run from holding a runner or racing a publish.
#
# ci-check and ci.yml both call this script, so the rule and the command that
# enforces it cannot drift apart - the same reason scripts/gut-check owns the
# GUT command. GPTY_WORKFLOW_DIR points the linter at a fixture for testing.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

python3 - <<'PY'
import os
import re
import sys
from pathlib import Path

import yaml

WORKFLOW_DIR = Path(os.environ.get("GPTY_WORKFLOW_DIR", ".github/workflows"))
WORKFLOWS = sorted(
    set(WORKFLOW_DIR.glob("*.yml")) | set(WORKFLOW_DIR.glob("*.yaml"))
)
if not WORKFLOWS:
    print(f"  ERROR: no workflows found under {WORKFLOW_DIR}", file=sys.stderr)
    sys.exit(1)
errors = []
for path in WORKFLOWS:
    name = path.name
    try:
        doc = yaml.safe_load(path.read_text())
    except Exception as exc:
        errors.append(f"{name}: {exc}")
        continue
    if not isinstance(doc, dict):
        errors.append(f"{name}: not a YAML mapping")
        continue

    file_errors = []

    def bad(where, message):
        file_errors.append(f"{name}{where}: {message}")

    # Top-level least privilege.
    perms = doc.get("permissions")
    if perms is None:
        bad("", "no top-level permissions block")
    elif not isinstance(perms, (dict, str)):
        bad("", "permissions must be a mapping or a level name")

    # One concurrency group per workflow.
    concurrency = doc.get("concurrency")
    if not isinstance(concurrency, dict) or not concurrency.get("group"):
        bad("", "no top-level concurrency block with a group")

    # Dangerous triggers: a write-token workflow must not run a PR's tree.
    triggers = doc.get("on", doc.get(True))
    if isinstance(triggers, str):
        trigger_names = {triggers}
    elif isinstance(triggers, list):
        trigger_names = set(triggers)
    elif isinstance(triggers, dict):
        trigger_names = set(triggers)
    else:
        trigger_names = set()
    for dangerous in ("pull_request_target", "workflow_run"):
        if dangerous in trigger_names:
            bad("", f"dangerous trigger: {dangerous}")

    jobs = doc.get("jobs")
    if not isinstance(jobs, dict) or not jobs:
        bad("", "no jobs mapping")
    else:
        for job_name, job in jobs.items():
            where = f": {job_name}"
            if not isinstance(job, dict):
                bad(where, "job is not a mapping")
                continue
            job_uses = job.get("uses")
            # A job that calls a reusable workflow cannot declare
            # `timeout-minutes` - GitHub's call-job keyword set excludes it, so
            # the timeout is the called workflow's own, per job (release.yml's
            # `build` calls release-build.yml, whose jobs each carry one).
            if job_uses is None:
                timeout = job.get("timeout-minutes")
                if type(timeout) is not int or timeout <= 0:
                    bad(where, "job has no positive integer timeout-minutes")

            if job_uses is not None:
                steps = []
                check_uses = (where, job_uses)
            else:
                steps = job.get("steps")
                check_uses = None
                if not isinstance(steps, list) or not steps:
                    bad(where, "job has no steps")
                    steps = []
            if check_uses is not None:
                uses = check_uses[1]
                if not (isinstance(uses, str) and (
                    uses.startswith("./")
                    or re.search(r"@[0-9a-f]{40}$", uses)
                    or re.search(r"@sha256:[0-9a-f]{64}$", uses)
                )):
                    bad(where, f"unpinned action {uses!r}")

            for index, step in enumerate(steps):
                step_where = f"{where}: step {index + 1}"
                if not isinstance(step, dict):
                    bad(step_where, "step is not a mapping")
                    continue
                uses = step.get("uses")
                if uses is None:
                    continue
                if not isinstance(uses, str) or not uses:
                    bad(step_where, "uses must be a non-empty string")
                    continue
                if uses.startswith("./"):
                    pass
                elif uses.startswith("docker://"):
                    if not re.search(r"@sha256:[0-9a-f]{64}$", uses):
                        bad(step_where, f"unpinned Docker action {uses!r}")
                elif not re.search(r"@[0-9a-f]{40}$", uses):
                    bad(step_where, f"unpinned action {uses!r}")
                if uses.startswith("actions/checkout@"):
                    with_ = step.get("with")
                    if not isinstance(with_, dict) or with_.get("persist-credentials") not in (False, "false"):
                        bad(step_where, "actions/checkout must set with.persist-credentials: false")

    if file_errors:
        errors.extend(file_errors)
    else:
        print(f"  OK: {name}")

for err in errors:
    print(f"  ERROR: {err}", file=sys.stderr)
sys.exit(1 if errors else 0)
PY
