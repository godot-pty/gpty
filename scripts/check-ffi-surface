#!/usr/bin/env python3
"""Check the GDExtension boundary: GDScript call sites against `#[func]` exports.

A renamed or removed `#[func]` does not fail at GDScript parse time — the call
fails at runtime, in whichever pane happens to exercise it, and often only in a
log line. The same is true of a call with the wrong number of arguments.

This walks the exported surface out of `crates/gpty-gdext/src/*.rs`, finds the
identifiers that GDScript holds a GDExtension class in, and checks every
`handle.method(...)` call against that surface.

A `#[func]` is attributed to the class named by its enclosing `#[godot_api]
impl` block — the primary one or any `#[godot_api(secondary)]` block, which is
how gdext lets one class be implemented across several files. The rule used to
be "the first `struct` in the file", which silently dropped every method the
moment a class grew a second file; the count is asserted per class instead, and
a `#[func]` outside such a block is reported rather than ignored.

It also checks the crate's own prose — `crates/gpty-gdext/README.md` and the
`///`/`//!` comments in `src/*.rs`: a backticked `name(...)` there must be a
real export or a plain `fn` in the crate. The README is what a caller reads
before writing the first call, and a name that never existed costs the same
round trip as a renamed export — `get_grid_rows()` was named in three places
and existed in none.

Exit codes: 0 clean, 1 problems found. Reads only; never writes.
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
GEXT_SRC = ROOT / "crates" / "gpty-gdext" / "src"
GODOT_SCENES = ROOT / "godot" / "scenes"

FUNC_RE = re.compile(r"#\[func\]")
FN_RE = re.compile(r"\bfn\s+([a-z_][a-z0-9_]*)\s*\(")
# `#[godot_api]` / `#[godot_api(secondary)]` markers, and the impl header that
# follows one: `impl Foo {` or `impl Trait for Foo {`.
GODOT_API_RE = re.compile(r"#\[godot_api(?:\([^)]*\))?\]")
IMPL_RE = re.compile(r"\bimpl\s+(?:[A-Za-z_][A-Za-z0-9_:]*\s+for\s+)?([A-Z][A-Za-z0-9_]*)\s*(?:where[^{]*)?\{")

# Members GDScript may legitimately call on a GDExtension object without a
# `#[func]`: they come from Godot's Object/Node rather than the class itself.
# Fail-closed on purpose — a name that is neither an export nor listed here is
# reported, so a newly used inherited member shows up once and gets added
# deliberately instead of the check silently widening.
INHERITED_MEMBERS = {
    "add_child",
    "call_deferred",
    "connect",
    "disconnect",
    "emit_signal",
    "free",
    "get",
    "get_instance_id",
    "get_meta",
    "has_method",
    "has_meta",
    "new",
    "is_inside_tree",
    "is_queued_for_deletion",
    "queue_free",
    "set",
    "set_meta",
}

# Names the crate's own prose may use that are neither `#[func]` exports nor
# plain `fn`s in this crate. Fail-closed like INHERITED_MEMBERS: a new name is
# reported once and added here deliberately, with its reason.
DOC_ALLOWED_NAMES = {
    # Godot's own callbacks, named where the docs explain what the renderer or
    # a pane does with the bridge.
    "_draw",
    "_exit_tree",
    "_process",
    "_ready",
    # gpty-ipc's state-directory helper: the profiles doc says where the store
    # lives, not that the class has such a method.
    "state_dir",
    # `IpcServer::serve` from gpty-ipc: the retry-loop doc names the imported
    # server's own method, not one of this class's.
    "serve",
}

DOC_TOKEN_RE = re.compile(r"`([A-Za-z_][A-Za-z0-9_]*)\(")
GEXT_README = ROOT / "crates" / "gpty-gdext" / "README.md"


def balanced_args(text: str, open_paren: int) -> str:
    """Return the argument list of a call whose '(' is at `open_paren`."""
    depth = 0
    for i in range(open_paren, len(text)):
        ch = text[i]
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                return text[open_paren + 1 : i]
    return ""


def split_args(arglist: str) -> list[str]:
    """Split on top-level commas (generics and nested calls included)."""
    out, depth, current = [], 0, []
    for ch in arglist:
        if ch in "(<[{":
            depth += 1
        elif ch in ")>]}":
            depth -= 1
        if ch == "," and depth == 0:
            out.append("".join(current))
            current = []
        else:
            current.append(ch)
    if current:
        out.append("".join(current))
    return [a.strip() for a in out if a.strip()]


def impl_blocks(text: str) -> list[tuple[str, int, int]]:
    """(class, start, end) for every `#[godot_api]` impl block in a file.

    A block runs from its marker to the next marker (or the end of the file):
    a `#[func]` cannot live outside an impl block, so the region is exactly the
    block for this purpose, and brace-counting would have to survive braces
    inside string literals.
    """
    markers = [m.start() for m in GODOT_API_RE.finditer(text)]
    blocks = []
    for n, start in enumerate(markers):
        header = IMPL_RE.search(text, start, markers[n + 1] if n + 1 < len(markers) else len(text))
        if header is None:
            continue
        blocks.append((header.group(1), start, markers[n + 1] if n + 1 < len(markers) else len(text)))
    return blocks


def exported_surface() -> tuple[dict[str, dict[str, int]], list[str]]:
    """class name -> {method: arity}; plus any `#[func]` the walk could not place."""
    surface: dict[str, dict[str, int]] = {}
    unplaced: list[str] = []
    for path in sorted(GEXT_SRC.glob("*.rs")):
        text = path.read_text()
        blocks = impl_blocks(text)
        placed = 0
        for class_name, start, end in blocks:
            region = text[start:end]
            methods = surface.setdefault(class_name, {})
            for marker in FUNC_RE.finditer(region):
                placed += 1
                fn = FN_RE.search(region, marker.end())
                if not fn:
                    continue
                params = split_args(balanced_args(region, region.index("(", fn.end() - 1)))
                params = [p for p in params if p not in ("&self", "&mut self", "self", "mut self")]
                methods[fn.group(1)] = len(params)
        total = len(FUNC_RE.findall(text))
        if placed != total:
            unplaced.append(
                f"{path.relative_to(ROOT)}: {total - placed} #[func] outside a #[godot_api] impl block"
            )
    return {c: m for c, m in surface.items() if m}, unplaced


def gdscript_handles(text: str, classes: set[str]) -> dict[str, str]:
    """identifier -> class name, for locals/handles holding an FFI class."""
    handles: dict[str, str] = {}
    for cls in classes:
        for pattern in (
            rf"\b([A-Za-z_][A-Za-z0-9_]*)\s*=\s*{cls}\.new\s*\(",
            rf"\b([A-Za-z_][A-Za-z0-9_]*)\s*=\s*ClassDB\.instantiate\(\s*\"{cls}\"\s*\)",
        ):
            for m in re.finditer(pattern, text):
                handles[m.group(1)] = cls
    # The class name itself: GDExtension classes expose `#[func]` methods
    # statically (the engine-global accessors are the established pattern), and
    # `GptyTerminal.history_store_stats()` is as renameable as any handle call.
    for cls in classes:
        handles.setdefault(cls, cls)
    # Handles handed out at runtime rather than constructed in place: a pane
    # body owns its terminal and exposes it as `_terminal`, and
    # `get_terminal_for_ffi()` returns one. Without these two rules every
    # `term.<method>()` call in workspace.gd went unchecked — which is exactly
    # where a renamed export would fail at runtime with no test noticing.
    if "GptyTerminal" in classes:
        for pattern in (
            r"\b([A-Za-z_][A-Za-z0-9_]*)\s*=\s*[^\n=]*\.get\(\s*\"_terminal\"\s*\)",
            r"\b([A-Za-z_][A-Za-z0-9_]*)\s*=\s*get_terminal_for_ffi\s*\(\s*\)",
        ):
            for m in re.finditer(pattern, text):
                handles[m.group(1)] = "GptyTerminal"
    return handles


def crate_docs() -> list[tuple[str, str]]:
    """(label, text) for the crate's own prose: README and doc comments."""
    docs = [(str(GEXT_README.relative_to(ROOT)), GEXT_README.read_text())]
    for path in sorted(GEXT_SRC.glob("*.rs")):
        lines = [
            line.strip()
            for line in path.read_text().splitlines()
            if line.strip().startswith(("///", "//!"))
        ]
        if lines:
            docs.append((f"{path.relative_to(ROOT)} doc comments", "\n".join(lines)))
    return docs


def doc_problems(surface: dict[str, dict[str, int]]) -> tuple[int, list[str]]:
    """Backticked `name(...)` in the crate's prose must name something real."""
    exported = {name for methods in surface.values() for name in methods}
    crate_fns = {
        m.group(1)
        for path in GEXT_SRC.glob("*.rs")
        for m in FN_RE.finditer(path.read_text())
    }
    checked, problems = 0, []
    for label, text in crate_docs():
        for m in DOC_TOKEN_RE.finditer(text):
            name = m.group(1)
            checked += 1
            if name in exported or name in crate_fns or name in DOC_ALLOWED_NAMES:
                continue
            problems.append(
                f"{label}: `{name}()` — not an export of this crate and not a plain fn"
            )
    return checked, problems


def main() -> int:
    surface, unplaced = exported_surface()
    if not surface:
        print("check-ffi-surface: no #[func] exports found — wrong directory?")
        return 1

    total_calls = 0
    problems: list[str] = list(unplaced)

    for path in sorted(GODOT_SCENES.rglob("*.gd")):
        text = path.read_text()
        # Strip comments so prose mentioning a call is not mistaken for one.
        stripped = "\n".join(re.sub(r"#.*$", "", line) for line in text.splitlines())
        rel = path.relative_to(ROOT)
        for handle, cls in gdscript_handles(stripped, set(surface)).items():
            methods = surface[cls]
            for call in re.finditer(rf"\b{re.escape(handle)}\.([a-z_][a-z0-9_]*)\s*\(", stripped):
                name = call.group(1)
                total_calls += 1
                if name in INHERITED_MEMBERS:
                    continue
                if name not in methods:
                    problems.append(
                        f"{rel}: {handle}.{name}() — {cls} has no #[func] '{name}'"
                    )
                    continue
                args = split_args(balanced_args(stripped, call.end() - 1))
                if len(args) != methods[name]:
                    problems.append(
                        f"{rel}: {handle}.{name}() called with {len(args)} args, "
                        f"but the #[func] takes {methods[name]}"
                    )

    doc_checked, doc_issues = doc_problems(surface)
    problems.extend(doc_issues)

    if problems:
        print(f"check-ffi-surface: {len(problems)} problem(s) across {total_calls} calls")
        for problem in problems:
            print(f"  {problem}")
        return 1

    classes = ", ".join(f"{c} ({len(m)})" for c, m in sorted(surface.items()))
    print(f"check-ffi-surface: {total_calls} calls match the export surface — {classes}")
    print(f"check-ffi-surface: {doc_checked} names in the crate's prose are real methods")
    return 0


if __name__ == "__main__":
    sys.exit(main())
