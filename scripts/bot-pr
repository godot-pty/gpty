#!/usr/bin/env bash
# Open a pull request as gpty-bot. Push the branch first with scripts/bot-push.
#
# Usage: scripts/bot-pr [--base main] [--title TITLE] [--body-file FILE]
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

base=main
title=
body=
while [ $# -gt 0 ]; do
    case "$1" in
        --base) base=${2:?--base needs a value}; shift 2 ;;
        --title) title=${2:?--title needs a value}; shift 2 ;;
        --body-file) body=${2:?--body-file needs a value}; shift 2 ;;
        *) echo "usage: scripts/bot-pr [--base main] [--title TITLE] [--body-file FILE]" >&2; exit 2 ;;
    esac
done

head=$(git branch --show-current)
if [ -z "$head" ]; then
    echo "bot-pr: no current branch" >&2
    exit 2
fi
if [ "$head" = "$base" ]; then
    echo "bot-pr: refusing to open a PR from $base to itself" >&2
    exit 2
fi

args=(--base "$base" --head "$head")
if [ -n "$title" ]; then
    args+=(--title "$title")
    if [ -n "$body" ]; then
        args+=(--body-file "$body")
    else
        args+=(--body "")
    fi
else
    args+=(--fill)
    if [ -n "$body" ]; then
        args+=(--body-file "$body")
    fi
fi

token=$(./scripts/bot-token)
GH_TOKEN="$token" gh pr create "${args[@]}"
