#!/usr/bin/env bash
# Stage one UI state in a private sandbox and save the app's own viewport.
#
# Usage: scripts/ui-capture <state> <out-dir>     # writes <out-dir>/<state>.png
#        scripts/ui-capture --audit-focus <state> # print keyboard reachability
#        scripts/ui-capture --audit-accessibility <state> # print the AT surface
#        scripts/ui-capture --list                # the state names
#        scripts/ui-capture --compare <a> <b>     # pixel comparison, exit 0/1
#
# `--perturb <state>` may follow a capture: it is the harness's locality
# self-test (one control shifted in that state only), and the only caller is
# scripts/ui-capture-check.
#
# The staging procedure is committed at godot/tests/bench/ui_capture.gd; this
# script only provides the environment it needs (see scripts/ui-sandbox) and
# the Godot command line. A real display driver is required for a capture —
# under `--headless` there is no redraw pass. `--list` and `--compare` are
# headless and need no display.
#
# Requires: godot on PATH (GODOT=<path> overrides), a graphical session.
# CAPTURE_TIMEOUT bounds one launch (default 120 s); a launch that produces no
# result is killed, so a stalled engine start cannot hold the caller.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GODOT_BIN="${GODOT:-$(command -v godot || true)}"
if [[ -z "$GODOT_BIN" ]]; then
    echo "ui-capture: godot not found on PATH (set GODOT=<path>)" >&2
    exit 3
fi

usage() {
    echo "usage: ui-capture <state> <out-dir> [--perturb <state>] | --audit-focus <state> | --audit-accessibility <state> | --list | --compare <a.png> <b.png>" >&2
    exit 2
}

MODE=""
STATE=""
OUT=""
LEFT=""
RIGHT=""
case "${1:-}" in
    --list)
        MODE=list
        shift
        ;;
    --compare)
        [[ $# -eq 3 ]] || usage
        MODE=compare
        LEFT="$2"
        RIGHT="$3"
        shift 3
        ;;
    --audit-focus)
        [[ $# -eq 2 ]] || usage
        MODE=audit
        STATE="$2"
        shift 2
        ;;
    --audit-accessibility)
        [[ $# -eq 2 ]] || usage
        MODE=audit_a11y
        STATE="$2"
        shift 2
        ;;
    "" | -*)
        usage
        ;;
    *)
        [[ $# -ge 2 ]] || usage
        MODE=capture
        STATE="$1"
        OUT="$2"
        shift 2
        ;;
esac

EXTRA=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --perturb)
            [[ "$MODE" == capture && $# -ge 2 ]] || usage
            EXTRA+=(--perturb "$2")
            shift 2
            ;;
        *)
            usage
            ;;
    esac
done

if [[ "$MODE" == capture || "$MODE" == audit || "$MODE" == audit_a11y ]]; then
    case "$(uname -s)" in
        Linux)
            [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] || {
                echo "ui-capture: no display — staging needs a real driver (DISPLAY/WAYLAND_DISPLAY)" >&2
                exit 3
            }
            ;;
    esac
fi

# shellcheck source=scripts/ui-sandbox
. "$ROOT/scripts/ui-sandbox"
gpty_sandbox_init
trap gpty_sandbox_cleanup EXIT
cd "$ROOT"

# A capture is a few seconds. A launch that never presents a frame must not
# hold the caller: a stalled Godot sits in an event loop that never runs, so it
# leaves a blank window that ignores its close request and cannot be closed by
# hand (measured 2026-11-04: one launch stalled in engine start-up and blocked a
# UI-capture-check run for 23 minutes). Godot does not die on SIGTERM while a
# script waits, so the escalation is TERM, a moment, KILL.
CAPTURE_TIMEOUT="${CAPTURE_TIMEOUT:-120}"
if [[ ! "$CAPTURE_TIMEOUT" =~ ^[0-9]+$ || "$CAPTURE_TIMEOUT" -eq 0 ]]; then
    echo "ui-capture: CAPTURE_TIMEOUT must be a whole number of seconds" >&2
    exit 2
fi

run_bounded() {
    local label="$1"
    shift
    "$@" &
    local pid=$!
    local deadline=$(( SECONDS + CAPTURE_TIMEOUT ))
    while kill -0 "$pid" 2>/dev/null; do
        if (( SECONDS >= deadline )); then
            echo "ui-capture: $label produced no result in ${CAPTURE_TIMEOUT}s — killing the launch" >&2
            kill -TERM "$pid" 2>/dev/null || true
            for _ in 1 2 3 4 5; do
                kill -0 "$pid" 2>/dev/null || break
                sleep 0.2
            done
            kill -KILL "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            return 1
        fi
        sleep 0.2
    done
    wait "$pid"
}

HARNESS=res://tests/bench/ui_capture.gd
case "$MODE" in
    list)
        # Godot prints its banner and driver lines on stdout too; a state name
        # is the only kind of line this filter keeps, so callers get one name
        # per line with no engine noise.
        "$GODOT_BIN" --headless --path "$ROOT/godot" -s "$HARNESS" -- --list \
            | grep -E '^[a-z][a-z0-9-]*$'
        ;;
    compare)
        "$GODOT_BIN" --headless --path "$ROOT/godot" -s "$HARNESS" -- --compare "$LEFT" "$RIGHT"
        ;;
    capture)
        run_bounded "$STATE" "$GODOT_BIN" --path "$ROOT/godot" --disable-vsync \
            -s "$HARNESS" -- --state "$STATE" --out "$OUT" "${EXTRA[@]}"
        ;;
    audit)
        run_bounded "$STATE" "$GODOT_BIN" --path "$ROOT/godot" --disable-vsync \
            -s "$HARNESS" -- --state "$STATE" --audit-focus
        ;;
    audit_a11y)
        run_bounded "$STATE" "$GODOT_BIN" --path "$ROOT/godot" --disable-vsync \
            -s "$HARNESS" -- --state "$STATE" --audit-accessibility
        ;;
esac
