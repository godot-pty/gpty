#!/usr/bin/env bash
# Stage one UI state in a private sandbox and save the app's own viewport.
#
# Usage: scripts/ui-capture <state> <out-dir> [--save <file>] # writes <out-dir>/<state>.png
#        scripts/ui-capture <state> --save <file>            # writes only <file>
#        scripts/ui-capture --audit-focus <state> # print keyboard reachability
#        scripts/ui-capture --audit-accessibility <state> # print the AT surface
#        scripts/ui-capture --list                # the state names
#        scripts/ui-capture --compare <a> <b>     # pixel comparison, exit 0/1
#
# `--renderer forward_plus|mobile|gl_compatibility` may lead any capture or
# audit: it forces the engine's rendering method for that launch (the renderer
# bake-off, or checking the Compatibility fallback). Without it the project's
# pinned Forward+ setting is used; `--list` and `--compare` ignore it.
#
# `--perturb <state>` may follow a capture: it is the harness's locality
# self-test (one control shifted in that state only), and the only caller is
# scripts/ui-capture-check.
#
# `--unpinned-arrival` may follow a capture: it starts a shipped arrival and
# leaves it running, so the capture must refuse (the arrival-pin gate's
# negative control). scripts/ui-capture-check is its only caller.
#
# The staging procedure is committed at godot/tests/bench/ui_capture.gd; this
# script only provides the environment it needs (see scripts/ui-sandbox) and
# the Godot command line. A capture whose engine log carries a SCRIPT ERROR or
# "Failed to load script" fails: a `-s` entry point that did not compile still
# writes a PNG, and that image is not a capture of the app (the v0.8.4 harness
# fix). A real display driver is required for a capture —
# under `--headless` there is no redraw pass. `--list` and `--compare` are
# headless and need no display. `--list` also loads the harness through Godot's
# own dependency compile, which is the gate for the script-mode autoload trap:
# a project class named in the harness fails the load before any state is
# printed. `scripts/ci-check` and CI run it for that reason.
#
# Requires: godot on PATH (GODOT=<path> overrides), a graphical session.
# CAPTURE_TIMEOUT bounds one launch (default 120 s); a launch that produces no
# result is killed, so a stalled engine start cannot hold the caller.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GODOT_BIN="${GODOT:-$(command -v godot || true)}"
if [[ -z "$GODOT_BIN" ]]; then
    echo "ui-capture: godot not found on PATH (set GODOT=<path>)" >&2
    exit 3
fi

usage() {
    echo "usage: ui-capture [--renderer <method>] <state> [<out-dir>] [--perturb <state>] [--unpinned-arrival] [--save <file>] | --audit-focus <state> | --audit-accessibility <state> | --list | --compare <a.png> <b.png>" >&2
    exit 2
}

RENDERER=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --renderer)
            [[ $# -ge 2 ]] || usage
            RENDERER="$2"
            shift 2
            ;;
        *)
            break
            ;;
    esac
done
RENDER_FLAGS=()
case "$RENDERER" in
    "")
        ;;
    forward_plus | mobile | gl_compatibility)
        RENDER_FLAGS=(--rendering-method "$RENDERER")
        ;;
    *)
        echo "ui-capture: unknown renderer '$RENDERER' (forward_plus|mobile|gl_compatibility)" >&2
        exit 2
        ;;
esac

MODE=""
STATE=""
OUT=""
LEFT=""
RIGHT=""
SAVE=""
TEMP_OUT_DIR=""
case "${1:-}" in
    --list)
        MODE=list
        shift
        ;;
    --compare)
        [[ $# -eq 3 ]] || usage
        MODE=compare
        LEFT="$2"
        RIGHT="$3"
        shift 3
        ;;
    --audit-focus)
        [[ $# -eq 2 ]] || usage
        MODE=audit
        STATE="$2"
        shift 2
        ;;
    --audit-accessibility)
        [[ $# -eq 2 ]] || usage
        MODE=audit_a11y
        STATE="$2"
        shift 2
        ;;
    "" | -*)
        usage
        ;;
    *)
        [[ "$1" != -* ]] || usage
        MODE=capture
        STATE="$1"
        if [[ $# -ge 2 && "$2" != -* ]]; then
            OUT="$2"
            shift 2
        else
            shift
        fi
        ;;
esac

EXTRA=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --perturb)
            [[ "$MODE" == capture && $# -ge 2 ]] || usage
            EXTRA+=(--perturb "$2")
            shift 2
            ;;
        --unpinned-arrival)
            [[ "$MODE" == capture ]] || usage
            EXTRA+=(--unpinned-arrival)
            shift
            ;;
        --save)
            [[ "$MODE" == capture && $# -ge 2 ]] || usage
            SAVE="$2"
            shift 2
            ;;
        *)
            usage
            ;;
    esac
done

if [[ "$MODE" == capture && -z "$OUT" ]]; then
    [[ -n "$SAVE" ]] || usage
    # --save alone: the raw capture goes to a scratch dir the trap removes.
    TEMP_OUT_DIR="$(mktemp -d)"
    OUT="$TEMP_OUT_DIR"
fi

if [[ "$MODE" == capture || "$MODE" == audit || "$MODE" == audit_a11y ]]; then
    case "$(uname -s)" in
        Linux)
            [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] || {
                echo "ui-capture: no display — staging needs a real driver (DISPLAY/WAYLAND_DISPLAY)" >&2
                exit 3
            }
            ;;
    esac
fi

# shellcheck source=scripts/ui-sandbox
. "$ROOT/scripts/ui-sandbox"
gpty_sandbox_init
cleanup_capture() {
    gpty_sandbox_cleanup
    if [[ -n "$TEMP_OUT_DIR" ]]; then
        rm -rf "$TEMP_OUT_DIR"
    fi
}
trap cleanup_capture EXIT
cd "$ROOT"

# A capture is a few seconds. A launch that never presents a frame must not
# hold the caller: a stalled Godot sits in an event loop that never runs, so it
# leaves a blank window that ignores its close request and cannot be closed by
# hand (measured 2026-11-04: one launch stalled in engine start-up and blocked a
# UI-capture-check run for 23 minutes). Godot does not die on SIGTERM while a
# script waits, so the escalation is TERM, a moment, KILL.
CAPTURE_TIMEOUT="${CAPTURE_TIMEOUT:-120}"
if [[ ! "$CAPTURE_TIMEOUT" =~ ^[0-9]+$ || "$CAPTURE_TIMEOUT" -eq 0 ]]; then
    echo "ui-capture: CAPTURE_TIMEOUT must be a whole number of seconds" >&2
    exit 2
fi

run_bounded() {
    local label="$1"
    shift
    "$@" &
    local pid=$!
    local deadline=$(( SECONDS + CAPTURE_TIMEOUT ))
    while kill -0 "$pid" 2>/dev/null; do
        if (( SECONDS >= deadline )); then
            echo "ui-capture: $label produced no result in ${CAPTURE_TIMEOUT}s — killing the launch" >&2
            kill -TERM "$pid" 2>/dev/null || true
            for _ in 1 2 3 4 5; do
                kill -0 "$pid" 2>/dev/null || break
                sleep 0.2
            done
            kill -KILL "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            return 1
        fi
        sleep 0.2
    done
    wait "$pid"
}

HARNESS=res://tests/bench/ui_capture.gd
case "$MODE" in
    list)
        # Godot prints its banner and driver lines on stdout too; a state name
        # is the only kind of line this filter keeps, so callers get one name
        # per line with no engine noise. The engine log is judged, not only the
        # exit code: a harness whose dependency failed to compile (a named app
        # class against the not-yet-registered autoloads) still runs and prints
        # every state name, so the dependency's SCRIPT ERROR is the only
        # evidence - the same rule the capture path applies to its log.
        LIST_LOG="$(mktemp)"
        set +e
        "$GODOT_BIN" --headless --path "$ROOT/godot" -s "$HARNESS" -- --list \
            >"$LIST_LOG" 2>&1
        LIST_STATUS=$?
        set -e
        if grep -qE 'SCRIPT ERROR|Failed to load script' "$LIST_LOG"; then
            echo "ui-capture: the capture harness printed a script error — the load is not clean" >&2
            grep -E 'SCRIPT ERROR|Failed to load script' "$LIST_LOG" | head -3 >&2
            rm -f "$LIST_LOG"
            exit 1
        fi
        STATES_OUT="$(grep -E '^[a-z][a-z0-9-]*$' "$LIST_LOG")" || true
        rm -f "$LIST_LOG"
        if [[ -z "$STATES_OUT" ]]; then
            echo "ui-capture: the capture harness listed no states" >&2
            exit 1
        fi
        printf '%s\n' "$STATES_OUT"
        exit "$LIST_STATUS"
        ;;
    compare)
        "$GODOT_BIN" --headless --path "$ROOT/godot" -s "$HARNESS" -- --compare "$LEFT" "$RIGHT"
        ;;
    capture)
        # Engine output is kept, not only the PNG: a `-s` entry point that
        # fails to compile still writes an image, and the app can stage that
        # image with pane bodies that never loaded (measured 2026-11-16: every
        # tile was a bare `Control` while the capture looked plausible). A
        # script error means the image is not a capture of the app.
        CAPTURE_LOG="$(mktemp)"
        set +e
        run_bounded "$STATE" "$GODOT_BIN" --path "$ROOT/godot" --disable-vsync "${RENDER_FLAGS[@]}" \
            -s "$HARNESS" -- --state "$STATE" --out "$OUT" "${EXTRA[@]}" 2>&1 \
            | tee "$CAPTURE_LOG"
        CAPTURE_STATUS=${PIPESTATUS[0]}
        set -e
        if grep -qE 'SCRIPT ERROR|Failed to load script' "$CAPTURE_LOG"; then
            echo "ui-capture: $STATE printed a script error — the capture is not trustworthy" >&2
            rm -f "$CAPTURE_LOG"
            exit 1
        fi
        rm -f "$CAPTURE_LOG"
        if [[ -n "$SAVE" && "$CAPTURE_STATUS" -eq 0 ]]; then
            mkdir -p "$(dirname "$SAVE")"
            cp "$OUT/$STATE.png" "$SAVE"
            echo "ui-capture: saved $SAVE"
        fi
        exit "$CAPTURE_STATUS"
        ;;
    audit)
        run_bounded "$STATE" "$GODOT_BIN" --path "$ROOT/godot" --disable-vsync "${RENDER_FLAGS[@]}" \
            -s "$HARNESS" -- --state "$STATE" --audit-focus
        ;;
    audit_a11y)
        run_bounded "$STATE" "$GODOT_BIN" --path "$ROOT/godot" --disable-vsync "${RENDER_FLAGS[@]}" \
            -s "$HARNESS" -- --state "$STATE" --audit-accessibility
        ;;
esac
