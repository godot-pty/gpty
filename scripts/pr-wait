#!/usr/bin/env bash
# Wait for a pull request to land through main's merge queue.
#
# Usage: scripts/pr-wait [<pr>] [--base BRANCH] [--timeout SEC] [--interval SEC]
#
# Polls the PR, its merge-queue entry and the merge-group runs until the PR is
# merged, closed or the timeout expires. It prints the queue state only when it
# changes, fails as soon as a merge-group run fails, and ends with the merge
# commit and every merge-group run's conclusion - the evidence the commit skill
# asks for instead of "pushed".
#
# Exit: 0 merged, 1 failed or timed out, 2 closed, no PR, or a usage error.
# Needs an authenticated `gh` with read access to the repository and its
# Actions runs; it never pushes, approves or merges.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

pr=""
base="main"
timeout=1800
interval=15
while [ $# -gt 0 ]; do
    case "$1" in
        --base) base=${2:?--base needs a value}; shift 2 ;;
        --timeout) timeout=${2:?--timeout needs a value}; shift 2 ;;
        --interval) interval=${2:?--interval needs a value}; shift 2 ;;
        -h | --help)
            sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        -*) echo "pr-wait: unknown option $1" >&2; exit 2 ;;
        *)
            [ -z "$pr" ] || { echo "pr-wait: one PR number only" >&2; exit 2; }
            pr=$1
            shift
            ;;
    esac
done
for value in "$timeout" "$interval"; do
    if [[ ! "$value" =~ ^[0-9]+$ ]] || [ "$value" -eq 0 ]; then
        echo "pr-wait: --timeout and --interval must be positive integers" >&2
        exit 2
    fi
done
command -v gh >/dev/null 2>&1 || { echo "pr-wait: gh is not on PATH" >&2; exit 2; }

if [ -z "$pr" ]; then
    pr=$(gh pr view --json number --jq .number 2>/dev/null) || {
        echo "pr-wait: no PR number given and the current branch has no pull request" >&2
        exit 2
    }
fi

repo_fields=$(gh repo view --json owner,name --jq '.owner.login + " " + .name')
owner=${repo_fields%% *}
name=${repo_fields#* }

# The queue entry for this PR, or empty when the PR is not queued.
queue_state() {
    gh api graphql \
        -f query="{repository(owner:\"$owner\",name:\"$name\"){mergeQueue(branch:\"$base\"){entries(first:50){nodes{position state pullRequest{number}}}}}}" \
        --jq ".data.repository.mergeQueue.entries.nodes[]? | select(.pullRequest.number==$pr) | .state" \
        2>/dev/null || true
}

# One TAB-separated line per merge-group run for this PR, oldest output order.
merge_runs() {
    gh run list --event merge_group --limit 50 \
        --json databaseId,workflowName,status,conclusion,headBranch,url \
        --jq ".[] | select(.headBranch | contains(\"pr-$pr-\")) | [.databaseId,.workflowName,.status,(.conclusion // \"\"),.url] | @tsv" \
        2>/dev/null || true
}

deadline=$(( SECONDS + timeout ))
last=""
while :; do
    if ! pr_json=$(gh pr view "$pr" --json state,mergedAt,mergeCommit,autoMergeRequest 2>/dev/null); then
        echo "pr-wait: cannot read PR #$pr (wrong number, or no access)" >&2
        exit 2
    fi
    state=$(printf '%s' "$pr_json" | jq -r .state)
    case "$state" in
        MERGED)
            sha=$(printf '%s' "$pr_json" | jq -r '.mergeCommit.oid // ""')
            echo "pr-wait: #$pr merged as $sha"
            merge_runs | awk -F'\t' '{
                printf "pr-wait: run %s %s %s\n", $1, $2, ($4 == "" ? "in progress" : $4)
            }'
            exit 0
            ;;
        CLOSED)
            echo "pr-wait: #$pr is closed without merging" >&2
            exit 2
            ;;
    esac

    queue=$(queue_state)
    line="state=$state queue=${queue:-none}"
    if [ "$line" != "$last" ]; then
        echo "pr-wait: $line"
        last=$line
    fi

    failed=$(merge_runs | awk -F'\t' '$3 == "completed" && $4 != "success" { print $1, $2, $4, $5 }')
    if [ -n "$failed" ]; then
        echo "pr-wait: a merge-group run failed:" >&2
        printf '%s\n' "$failed" >&2
        exit 1
    fi

    if (( SECONDS >= deadline )); then
        echo "pr-wait: #$pr did not merge within ${timeout}s (state=$state queue=${queue:-none})" >&2
        if [ -z "$queue" ]; then
            if [ "$(printf '%s' "$pr_json" | jq -r '.autoMergeRequest == null')" = "true" ]; then
                echo "pr-wait: no queue entry and no auto-merge - approve it, then 'gh pr merge $pr --auto --merge'" >&2
            else
                echo "pr-wait: no queue entry yet - the queue takes it once approval and required checks are in" >&2
            fi
        fi
        exit 1
    fi
    sleep "$interval"
done
