#!/usr/bin/env bash
set -euo pipefail

# ── build: Build the standalone gpty app for the host platform ──────────
# Usage: ./scripts/build
# Detects the host OS + architecture, builds gpty-gdext in release mode,
# installs the library into godot/bin/, and exports the Godot project
# into dist/ for the platform this script runs on.
#
# Requirements: Rust toolchain, godot on PATH with export templates for
# exactly that Godot version installed (a 4.7.2 editor needs 4.7.2 templates;
# the preflight below fails early and prints the download command).
#
# Env overrides:
#   GODOT_BIN   Godot executable (default: godot)

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

# ── Color helpers ───────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'       # No Color
BOLD='\033[1m'

step()  { printf "\n${BOLD}── %s ──${NC}\n" "$1"; }
ok()    { printf "  ${GREEN}OK${NC} %s\n" "$1"; }
warn()  { printf "  ${YELLOW}NOTE${NC} %s\n" "$1"; }
die()   { printf "  ${RED}ERROR${NC} %s\n" "$1" >&2; exit 1; }

# ── Detect host platform ────────────────────────────────────────────────
OS_NAME="$(uname -s)"
ARCH="$(uname -m)"
case "$ARCH" in
    amd64|x86_64) ARCH="x86_64" ;;
    aarch64)      ARCH="arm64" ;;
esac

case "$OS_NAME" in
    Linux*)  PLATFORM="linux" ;;
    Darwin*) PLATFORM="macos" ;;
    MINGW*|MSYS*|CYGWIN*)
        PLATFORM="windows"
        ;;
    *)
        die "unsupported OS: $OS_NAME"
        ;;
esac

# Only architectures referenced in godot/gpty.gdextension are buildable.
case "$PLATFORM-$ARCH" in
    linux-x86_64|windows-x86_64|macos-x86_64|macos-arm64) ;;
    *)
        die "unsupported platform: $PLATFORM/$ARCH (godot/gpty.gdextension has no library entry for it)"
        ;;
esac

# ── Per-platform build parameters ───────────────────────────────────────
case "$PLATFORM" in
    linux)
        LIB_SRC="target/release/libgpty_gdext.so"
        LIB_DST="godot/bin/libgpty_gdext.linux.x86_64.so"
        EXPORT_PRESET="Linux/X11"
        EXPORT_DST="dist/gpty"
        ;;
    macos)
        LIB_SRC="target/release/libgpty_gdext.dylib"
        LIB_DST="godot/bin/libgpty_gdext.macos.$ARCH.dylib"
        EXPORT_PRESET="macOS"
        EXPORT_DST="dist/gpty.zip"
        ;;
    windows)
        LIB_SRC="target/release/gpty_gdext.dll"
        LIB_DST="godot/bin/gpty_gdext.windows.x86_64.dll"
        EXPORT_PRESET="Windows Desktop"
        EXPORT_DST="dist/gpty.exe"
        ;;
esac

GODOT_BIN="${GODOT_BIN:-godot}"

printf "${BOLD}Building gpty for %s/%s${NC}\n" "$PLATFORM" "$ARCH"

# ── Step 1: GDExtension library ────────────────────────────────────────
step "cargo build -p gpty-gdext --release"
cargo build -p gpty-gdext --release
ok "gdext release build"

step "Install library into godot/bin/"
mkdir -p godot/bin
cp "$LIB_SRC" "$LIB_DST"
ok "$LIB_DST"

# ── Step 2: Godot export ───────────────────────────────────────────────
command -v "$GODOT_BIN" >/dev/null 2>&1 \
    || die "godot not found on PATH — set GODOT_BIN or install Godot"

# Godot looks for export templates under <data>/godot/export_templates/<version>/
# where <version> is the editor's own string (e.g. 4.7.2.stable). A near-miss
# fails deep inside the export with "No export template found"; a symlinked
# directory that points at another version exports with the wrong engine build.
step "Export templates"
GODOT_VERSION="$("$GODOT_BIN" --version 2>/dev/null | cut -d. -f1-4)"
[ -n "$GODOT_VERSION" ] || die "could not read a version from $GODOT_BIN"

case "$PLATFORM" in
    linux)   TEMPLATE_FILE="linux_release.x86_64" ;;
    macos)   TEMPLATE_FILE="macos.zip" ;;
    windows) TEMPLATE_FILE="windows_release_x86_64.exe" ;;
esac
TEMPLATES_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/godot/export_templates"
if [ ! -f "$TEMPLATES_DIR/$GODOT_VERSION/$TEMPLATE_FILE" ]; then
    # Release tags hyphenate the channel: 4.7.2.stable -> 4.7.2-stable.
    GODOT_RELEASE="${GODOT_VERSION/.stable/-stable}"
    die "no $GODOT_VERSION export templates — $TEMPLATE_FILE is missing from
  $TEMPLATES_DIR/$GODOT_VERSION/
  installed there: $(ls "$TEMPLATES_DIR" 2>/dev/null | tr '\n' ' ')
  Install the templates for the editor you run (a symlink to another version
  is not a fix — the export comes out of the other engine build):
    curl -LO https://github.com/godotengine/godot-builds/releases/download/${GODOT_RELEASE}/Godot_v${GODOT_RELEASE}_export_templates.tpz
    unzip -q Godot_v${GODOT_RELEASE}_export_templates.tpz -d /tmp/godot-templates
    mkdir -p $TEMPLATES_DIR/$GODOT_VERSION
    mv /tmp/godot-templates/templates/* $TEMPLATES_DIR/$GODOT_VERSION/"
fi
ok "$TEMPLATE_FILE for $GODOT_VERSION"
if [ -f "$TEMPLATES_DIR/$GODOT_VERSION/version.txt" ]; then
    FOUND_VERSION="$(head -n 1 "$TEMPLATES_DIR/$GODOT_VERSION/version.txt" 2>/dev/null)"
    [ "$FOUND_VERSION" = "$GODOT_VERSION" ] \
        || warn "$TEMPLATES_DIR/$GODOT_VERSION holds $FOUND_VERSION templates; exports will come from that engine build"
fi

step "Import Godot project"
"$GODOT_BIN" --headless --path godot --import
ok "project imported"

step "Export $EXPORT_PRESET"
mkdir -p dist
"$GODOT_BIN" --headless --path godot --export-release "$EXPORT_PRESET" "$REPO_ROOT/$EXPORT_DST"
ok "$EXPORT_DST"

# Windows: Godot does not pack the GDExtension dll into the export, so it
# must sit next to the executable (mirrors release.yml).
if [[ "$PLATFORM" == "windows" ]]; then
    cp "$LIB_DST" "dist/"
    ok "dist/gpty_gdext.windows.x86_64.dll"
fi

# ── Summary ────────────────────────────────────────────────────────────
printf "\n${GREEN}${BOLD}Build complete.${NC}\n"
case "$PLATFORM" in
    linux)
        warn "Linux export is a bare executable + .pck — keep dist/gpty.pck next to dist/gpty"
        ;;
    macos)
        warn "macOS export is single-arch ($ARCH); CI stages both arm64 and x86_64 libraries"
        ;;
    windows)
        warn "run dist/gpty.exe from dist/ (the gdext dll must stay alongside it)"
        ;;
esac
printf "Artifact: ${BOLD}%s${NC}\n" "$EXPORT_DST"
