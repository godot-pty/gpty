#!/usr/bin/env bash
# Run the GUT (GDScript) suite and judge the run, not just the exit code.
#
# GUT's exit code does not mean the suite ran. A parse error in any collected
# .gd makes the collector break into Godot's debugger and the process still
# exits 0 — measured: 1.3 s instead of ~60 s, four scripts executed instead of
# forty, no Run Summary anywhere in the output. ci-check printed PASS off that
# exit code, so the whole GDScript suite could stop running unnoticed.
#
# This script owns the GUT command — ci-check and ci.yml both call it, so the
# command and its guard cannot drift apart — and then checks the output:
#   1. no Godot parse/script error before the first test starts (a collector or
#      autoload failure, how an aborted run announces itself);
#   2. a complete Run Summary, ending in "All tests passed!";
#   3. the script count GUT reports equals the test_*.gd files the -gdirs hold
#      (GUT does not recurse, so a test script nested below a -gdir would never
#      run — that is reported instead of silently shrinking the suite);
#   4. at least one test per collected script;
#   5. no `[Risky]` test (ran without asserting), and no `[Pending]` test
#      outside Windows — pending is how a test records a platform gap, so on
#      Linux/macOS it can only mean something was skipped by accident;
#   6. a runtime error GUT attributed to a test still fails the gate, but the
#      run finishes: the verdict prints GUT's own failing-test list and Godot's
#      `at:` location, because killing the run at the first error hid every
#      later failure (windows-smoke 44648884305).
#
# A run it cannot judge (a killed run, no Run Summary, a collection-time error,
# a count that does not add up) and a run it judged red are two verdicts, said
# separately - "not trustworthy" is reserved for the first.
#
# Requires godot on PATH; GODOT=<path> overrides.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

GODOT="${GODOT:-$(command -v godot || true)}"
if [[ -z "$GODOT" ]]; then
    echo "gut-check: godot not found on PATH (set GODOT=<path>)" >&2
    exit 1
fi

usage() {
    cat <<'EOF'
Usage: scripts/gut-check [options] [script_filter]

Run the GUT (GDScript) suite and judge the run, not just the exit code.

Options:
  -s, --select <pattern>    Run scripts whose filenames contain <pattern>
  -t, --test <pattern>      Run individual test methods matching <pattern>
  -d, --dir <dir>           Limit test discovery to <dir> (e.g. unit, integration)
      --timeout <sec>       Override overall timeout in seconds (default: 600)
      --stall-timeout <sec> Override stall detection timeout in seconds (default: 120)
  -h, --help                Show this help message and exit

Positional arguments:
  script_filter             Shorthand for --select (e.g. 'scripts/gut-check test_test_paths.gd')
EOF
    exit 0
}

SELECT=""
TEST_NAME=""
CUSTOM_DIRS=()
GUT_TIMEOUT="${GUT_TIMEOUT:-600}"
GUT_STALL_TIMEOUT="${GUT_STALL_TIMEOUT:-120}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            ;;
        -s|--select)
            if [[ $# -lt 2 ]]; then echo "gut-check: $1 requires an argument" >&2; exit 2; fi
            SELECT="$(basename "$2")"
            shift 2
            ;;
        --select=*)
            SELECT="$(basename "${1#*=}")"
            shift
            ;;
        -t|--test)
            if [[ $# -lt 2 ]]; then echo "gut-check: $1 requires an argument" >&2; exit 2; fi
            TEST_NAME="$2"
            shift 2
            ;;
        --test=*)
            TEST_NAME="${1#*=}"
            shift
            ;;
        -d|--dir)
            if [[ $# -lt 2 ]]; then echo "gut-check: $1 requires an argument" >&2; exit 2; fi
            CUSTOM_DIRS+=("$2")
            shift 2
            ;;
        --dir=*)
            CUSTOM_DIRS+=("${1#*=}")
            shift
            ;;
        --timeout)
            if [[ $# -lt 2 ]]; then echo "gut-check: $1 requires an argument" >&2; exit 2; fi
            GUT_TIMEOUT="$2"
            shift 2
            ;;
        --timeout=*)
            GUT_TIMEOUT="${1#*=}"
            shift
            ;;
        --stall-timeout)
            if [[ $# -lt 2 ]]; then echo "gut-check: $1 requires an argument" >&2; exit 2; fi
            GUT_STALL_TIMEOUT="$2"
            shift 2
            ;;
        --stall-timeout=*)
            GUT_STALL_TIMEOUT="${1#*=}"
            shift
            ;;
        -*)
            echo "gut-check: unknown option '$1' (see --help)" >&2
            exit 2
            ;;
        *)
            if [[ -z "$SELECT" ]]; then
                SELECT="$(basename "$1")"
            else
                echo "gut-check: unexpected argument '$1' (only one script filter is supported)" >&2
                exit 2
            fi
            shift
            ;;
    esac
done

for var in GUT_TIMEOUT GUT_STALL_TIMEOUT; do
    if [[ ! "${!var}" =~ ^[0-9]+$ ]]; then
        echo "gut-check: $var must be a whole number of seconds" >&2
        exit 1
    fi
done

if (( ${#CUSTOM_DIRS[@]} > 0 )); then
    TEST_DIRS=()
    for d in "${CUSTOM_DIRS[@]}"; do
        case "$d" in
            unit|godot/tests/unit|tests/unit)
                TEST_DIRS+=(godot/tests/unit)
                ;;
            integration|godot/tests/integration|tests/integration)
                TEST_DIRS+=(godot/tests/integration)
                ;;
            *)
                clean_d="${d#godot/}"
                if [[ -d "godot/$clean_d" ]]; then
                    TEST_DIRS+=("godot/$clean_d")
                elif [[ -d "$d" ]]; then
                    TEST_DIRS+=("$d")
                else
                    echo "gut-check: test directory '$d' does not exist" >&2
                    exit 2
                fi
                ;;
        esac
    done
else
    TEST_DIRS=(godot/tests/unit godot/tests/integration)
fi

IS_FILTERED=0
if [[ -n "$SELECT" || -n "$TEST_NAME" || ${#CUSTOM_DIRS[@]} -gt 0 ]]; then
    IS_FILTERED=1
fi

LOG="$(mktemp)"
PLAIN="$(mktemp)"

# ── A private endpoint and user profile for the suite ────────────────────
#
# The tests spawn real panes, and every gpty instance binds the control *and*
# event endpoints — one instance owns each. Running this gate while a workspace
# is open therefore made the test instance refuse the bind, set its own
# shutdown flag and quit mid-suite: measured 2026-10-14 as 12 scripts and no
# Run Summary at all, which reads as a crash rather than as "close the app".
#
# `GPTY_SOCKET` moves both endpoints (the event path is derived from the
# control one), so the suite never meets a developer's GUI; on Windows that is
# the same variable carrying a pipe name. The XDG dirs are the second half of
# the same rule: the suite's probe vaults, the vault index and the recovery
# copies stay inside the sandbox instead of the developer's real data and state
# directories, and a bare `Workspace` can no longer restore a real layout whose
# presence depends on the machine (the smoke sandboxes itself the same way).
#
# Windows ignores the XDG variables: Godot resolves `user://` through the Known
# Folder API and the Rust state dir comes from `%LOCALAPPDATA%`. Two levers
# cover that platform without either side guessing:
#   * `GPTY_TEST_USER_DIR` is the suite's user root. `BasePersistenceManager`
#     redirects every `user://` store through it and `history_db_path` does the
#     same for the scrollback database, so the stores and the gdext half cannot
#     disagree. It is set on every platform (on Unix it overlaps the XDG
#     sandbox on purpose: the seam is exercised by the normal gate, not only on
#     Windows).
#   * `LOCALAPPDATA`/`APPDATA` are the env-based half of Windows: the Rust
#     state and data directories read `%LOCALAPPDATA%` directly, so the plugin
#     store, vault index and recovery copies land in the sandbox too.
# No `--log-file`: Godot's file logging is off by default (`debug/file_logging`
# is unset in project.godot), so the run writes no engine log into the real user
# directory, and the pipeline below already captures stdout for the gate's
# judgment. The smoke uses the flag because it needs a failure-time engine log;
# adding it here was the only difference from the known-good Windows GUT run
# and the step hung with it (both the MSYS and the cygpath spelling), so it
# stays out until a Windows run can pin the cause. A bounded timeout below keeps
# a future hang from occupying the runner.
SANDBOX="$(mktemp -d)"
chmod 700 "$SANDBOX"
export XDG_RUNTIME_DIR="$SANDBOX/run"
export XDG_DATA_HOME="$SANDBOX/data"
export XDG_STATE_HOME="$SANDBOX/state"
mkdir -p "$XDG_RUNTIME_DIR" "$XDG_DATA_HOME" "$XDG_STATE_HOME" \
    "$SANDBOX/user" "$SANDBOX/localappdata" "$SANDBOX/roaming"
case "$(uname -s)" in
    MINGW* | MSYS* | CYGWIN*)
        IS_WINDOWS=1
        IS_DARWIN=0
        export GPTY_SOCKET='\\.\pipe\gpty-gut-'"$$"
        # Native processes cannot use the MSYS `/tmp/...` spelling, so the
        # sandbox is handed over as a Windows path.
        SANDBOX_WIN="$(cygpath -w "$SANDBOX")"
        export GPTY_TEST_USER_DIR="$SANDBOX_WIN\\user"
        export LOCALAPPDATA="$SANDBOX_WIN\\localappdata"
        export APPDATA="$SANDBOX_WIN\\roaming"
        ;;
    *)
        IS_WINDOWS=0
        if [[ "$(uname -s)" == Darwin ]]; then IS_DARWIN=1; else IS_DARWIN=0; fi
        export GPTY_SOCKET="$XDG_RUNTIME_DIR/gpty.sock"
        export GPTY_TEST_USER_DIR="$SANDBOX/user"
        ;;
esac
# A developer's shell may carry a secret this instance has no client for.
unset GPTY_SECRET

trap 'rm -f "$LOG" "$PLAIN"; rm -rf "$SANDBOX"' EXIT

# No `-d`: Godot parses it as `--debug`, so a runtime error in a test breaks
# into the interactive debugger (`Debugger Break`, `debug>`) — measured on
# Windows: one out-of-bounds index in a failing test flooded the step log
# with 1.7 GB of the same break and stalled the suite. Without it GUT records
# the failure and continues; the gate's own checks (Run Summary/all passed)
# are what judge the run, not Godot's debugger.
GUT_ARGS=(-s addons/gut/gut_cmdln.gd)
for dir in "${TEST_DIRS[@]}"; do
    GUT_ARGS+=("-gdir=res://${dir#godot/}")
done
if [[ -n "$SELECT" ]]; then
    GUT_ARGS+=("-gselect=$SELECT")
fi
if [[ -n "$TEST_NAME" ]]; then
    GUT_ARGS+=("-gunit_test_name=$TEST_NAME")
fi

# A hung suite must fail the gate, not hold the runner until GitHub's six-hour
# job cap. The suite is ~1.5 min here and ~3-5 min on Windows; 15 min is slack
# for a loaded runner. The deadline is enforced here rather than by `timeout`:
# Godot does not die on SIGTERM while a script waits, so `timeout 300` was
# still alive with its Godot child after seven minutes (measured 2026-11-02) —
# exactly how runs survived a 600 s cutoff. The same loop ends a run as soon as
# Godot reports a script/parse error: the collector cannot be judged after
# that, and waiting for the deadline hides the error the gate exists to report
# (measured: a deliberate parse error used to spend the whole timeout). The
# escalation is SIGTERM, one second, SIGKILL.
#
# A stalled run fails long before that deadline. The suite starts a test every
# ~0.15 s (913 tests in 134 s), and the longest single test waits 2.1 s, so
# two minutes with no output at all is a hang, not a slow test. Detecting that
# turns the measured wedge (a pane-spawning test stopped the suite; the run
# then burned the whole deadline) into a failure that names the test it stopped
# in, instead of a timeout a reader cannot attribute. `0` disables the check.

# `tail -f` streams the log to the terminal while the watchdog reads the same
# file; both stop once the child is reaped.
"$GODOT" --headless --path godot "${GUT_ARGS[@]}" >"$LOG" 2>&1 &
GUT_PID=$!
tail -n +1 -f "$LOG" 2>/dev/null &
TAIL_PID=$!
stop_tail() {
    kill "$TAIL_PID" 2>/dev/null || true
    wait "$TAIL_PID" 2>/dev/null || true
}

set +e
STATUS=0
TIMEOUT_HIT=0
COLLECT_ABORT=0
STALL_HIT=0
LOG_BLOWN=0
# A repeating runtime error prints without ever finishing a test, so the stall
# detector sees progress forever. 64 MiB is far past this suite's ~1 MB log and
# still bounds a runaway.
LOG_LIMIT=$(( 64 * 1024 * 1024 ))
LAST_SIZE=-1
LAST_PROGRESS=$SECONDS
DEADLINE=$(( SECONDS + GUT_TIMEOUT ))
while kill -0 "$GUT_PID" 2>/dev/null; do
    # Godot's error text is not one event. Before the first test starts (GUT
    # prints `* <test name>` at `_run_test`'s first line, log level 1) a
    # script/parse error means the collector or an autoload failed: the run
    # cannot be judged, and ending it here is what stops a deliberate parse
    # error from spending the whole deadline. Once a test has started, a
    # `SCRIPT ERROR` is GUT's to attribute - it fails that test with
    # `Unexpected Errors:` and runs the next one - and killing the run there is
    # what turned three out-of-bounds reads (windows-smoke 44648884305) into
    # "not trustworthy" with every later failure unrun.
    if ! grep -q '^\* ' "$LOG" 2>/dev/null \
        && grep -qE 'SCRIPT ERROR|Parse Error|Failed to load script' "$LOG" 2>/dev/null; then
        COLLECT_ABORT=1
        break
    fi
    SIZE="$(wc -c <"$LOG" 2>/dev/null || echo -1)"
    if [[ "$SIZE" =~ ^[0-9]+$ ]] && (( SIZE > LOG_LIMIT )); then
        LOG_BLOWN=1
        break
    fi
    if [[ "$SIZE" != "$LAST_SIZE" ]]; then
        LAST_SIZE="$SIZE"
        LAST_PROGRESS=$SECONDS
    elif (( GUT_STALL_TIMEOUT > 0 && SECONDS - LAST_PROGRESS >= GUT_STALL_TIMEOUT )); then
        STALL_HIT=1
        break
    fi
    if (( SECONDS >= DEADLINE )); then
        TIMEOUT_HIT=1
        break
    fi
    sleep 0.2
done
if (( COLLECT_ABORT || TIMEOUT_HIT || STALL_HIT || LOG_BLOWN )); then
    kill -TERM "$GUT_PID" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
        kill -0 "$GUT_PID" 2>/dev/null || break
        sleep 0.2
    done
    kill -KILL "$GUT_PID" 2>/dev/null || true
fi
wait "$GUT_PID"
STATUS=$?
stop_tail
set -e

# GUT colourises through a pipe too; match on a plain copy.
ESC=$'\033'
sed -E "s/${ESC}\[[0-9;?]*[A-Za-z]//g" "$LOG" > "$PLAIN"

# Where a killed run stopped: GUT prints the script's `.gd` path and then
# `* <test name>` as each test begins, so the tail of the log names the test and
# file to reproduce. Read before the message so a stall and a deadline report
# the same way.
LAST_TEST="$(awk '/^\* / { name = $0 } END { print name }' "$PLAIN" | sed -E 's/^\* //')"
LAST_SCRIPT="$(awk '{
        if (match($0, /[a-z]+:\/\/[^ ]*\.gd/)) last = substr($0, RSTART, RLENGTH)
    }
    END { print last }' "$PLAIN")"

# Totals block reads "Scripts              40" / "Tests               406". Read
# before the verdicts: a complete summary is what makes a red run judgeable, so
# it decides whether a Godot error is "the run is red" or "the gate cannot
# judge it".
SCRIPTS_RAN="$(awk '$1 == "Scripts" && $2 ~ /^[0-9]+$/ { print $2; exit }' "$PLAIN")"
TESTS_RAN="$(awk '$1 == "Tests" && $2 ~ /^[0-9]+$/ { print $2; exit }' "$PLAIN")"
if [[ -n "$SCRIPTS_RAN" && -n "$TESTS_RAN" ]]; then
    JUDGED=1
else
    JUDGED=0
fi

# Two verdicts, because they are two different claims. UNTRUSTED says the gate
# could not judge the run (killed, no summary, a collection failure, a count
# that does not add up): green off this run would be a lie. FAILURES says the
# run finished and is red: GUT's own summary and per-test list are the report.
UNTRUSTED=()
FAILURES=()

if (( STALL_HIT )); then
    UNTRUSTED+=("the run produced no output for ${GUT_STALL_TIMEOUT}s and was killed (a hung test or process)")
elif (( TIMEOUT_HIT )); then
    UNTRUSTED+=("the suite exceeded ${GUT_TIMEOUT}s and was killed (a hung test or process)")
elif (( LOG_BLOWN )); then
    UNTRUSTED+=("the run wrote more than $(( LOG_LIMIT / 1024 / 1024 )) MiB of output and was killed (a repeating error)")
fi
if (( STALL_HIT || TIMEOUT_HIT || LOG_BLOWN )); then
    if [[ -n "$LAST_TEST" ]]; then
        UNTRUSTED+=("the last test started was: $LAST_TEST")
    fi
    if [[ -n "$LAST_SCRIPT" ]]; then
        UNTRUSTED+=("in $LAST_SCRIPT")
        UNTRUSTED+=("re-run it alone: ./scripts/gut-check --select $(basename "$LAST_SCRIPT" .gd)")
    fi
    UNTRUSTED+=("the last lines were:")
    while IFS= read -r line; do
        UNTRUSTED+=("    $line")
    done < <(tail -n 8 "$PLAIN")
fi
if (( COLLECT_ABORT )); then
    UNTRUSTED+=("the run was aborted as soon as Godot reported a script/parse error before any test started — it cannot be judged")
elif [[ "$STATUS" -ne 0 ]] && (( ! STALL_HIT && ! TIMEOUT_HIT && ! LOG_BLOWN )); then
    if (( JUDGED )); then
        FAILURES+=("godot exited $STATUS")
    else
        UNTRUSTED+=("godot exited $STATUS")
    fi
fi

# `-A2` carries Godot's location lines (`at: res://.../<script>.gd:<line>` and
# the GDScript backtrace); without them the gate can say an error happened but
# not where, which is what `windows-smoke` 44648884305 printed. The count leads
# because a runtime error now finishes the run: there may be more than five.
ERROR_COUNT="$(grep -cE 'SCRIPT ERROR|Parse Error|Failed to load script' "$PLAIN" || true)"
ERROR_LINES="$(grep -Em5 -A2 'SCRIPT ERROR|Parse Error|Failed to load script' "$PLAIN" | sed '/^--$/d' || true)"
if [[ -n "$ERROR_LINES" ]]; then
    if (( JUDGED )); then
        FAILURES+=("Godot reported ${ERROR_COUNT} script/parse error(s) (the first five with location and backtrace):")
        while IFS= read -r line; do
            FAILURES+=("    $line")
        done <<<"$ERROR_LINES"
    else
        UNTRUSTED+=("Godot reported ${ERROR_COUNT} script/parse error(s), with no summary to judge (the first five with location and backtrace):")
        while IFS= read -r line; do
            UNTRUSTED+=("    $line")
        done <<<"$ERROR_LINES"
    fi
fi

# GUT's own failing-test report. `log_end_run` prints the header, every failing
# script with `- <test>` and its `[Failed]` lines, then `Totals` (summary.gd's
# log_end_run order), so the region between the two markers is exactly the list
# a reader needs instead of a log to grep.
FAIL_COUNT="$(awk '$1 == "Failing" && $2 == "Tests" && $3 ~ /^[0-9]+$/ { print $3; exit }' "$PLAIN")"
FAIL_COUNT="${FAIL_COUNT:-0}"
FAILED_BLOCK=""
if [[ "$FAIL_COUNT" != "0" ]]; then
    FAILED_BLOCK="$(awk '
        /^= Run Summary$/ { on = 1; next }
        on && /^Totals$/ { exit }
        on { print }
    ' "$PLAIN" | sed -e '/^=\+$/d' -e '/^$/d')"
fi
if [[ -n "$FAILED_BLOCK" ]]; then
    FAILURES+=("GUT reported $FAIL_COUNT failing test(s), with its own failure text:")
    while IFS= read -r line; do
        FAILURES+=("    $line")
    done < <(printf '%s\n' "$FAILED_BLOCK" | head -n 80)
    BLOCK_LINES="$(printf '%s\n' "$FAILED_BLOCK" | wc -l)"
    if (( BLOCK_LINES > 80 )); then
        FAILURES+=("    … $(( BLOCK_LINES - 80 )) more line(s); the full log is above")
    fi
fi

if [[ -z "$SCRIPTS_RAN" || -z "$TESTS_RAN" ]] \
    && (( ! STALL_HIT && ! TIMEOUT_HIT && ! COLLECT_ABORT && ! LOG_BLOWN )); then
    UNTRUSTED+=("no Run Summary in the output — the run stopped before it finished")
fi

# Pending tests are allowed on Windows and macOS, and printed: a fixture that
# needs a POSIX shell or a file mode has no Windows meaning, and macOS has no
# /proc. On Linux a pending test is a skip nobody decided on — a missing
# extension, an absent fixture — and a suite that skips quietly reports green
# for code it never ran, so it fails the run instead.
# A *risky* test — one that ran without asserting — is a real smell, so it fails.
RISKY="$(grep -c '\[Risky\]' "$PLAIN" || true)"
PENDING="$(grep -c '\[Pending\]' "$PLAIN" || true)"
PENDING_TOTAL="0"
if [[ "$RISKY" != "0" ]]; then
    FAILURES+=("a test ran without asserting ([Risky])")
fi
if [[ "$PENDING" != "0" && "$IS_WINDOWS" != "1" && "$IS_DARWIN" != "1" ]]; then
    FAILURES+=("pending tests are a Windows/macOS allowance, but these skipped on $(uname -s):")
    while IFS= read -r line; do
        FAILURES+=("    $line")
    done < <(grep -E '^ *\[Pending\]' "$PLAIN" | sort -u)
fi
if grep -q -- '---- All tests passed! ----' "$PLAIN"; then
    :
elif [[ "$PENDING" != "0" ]] && grep -qE -- '---- [0-9]+ pending/risky tests\. ----' "$PLAIN"; then
    # The number in that sentence is the authoritative count (GUT prints each
    # pending test twice in the log, so the line count is not).
    PENDING_TOTAL="$(grep -oE -- '---- [0-9]+ pending/risky tests\. ----' "$PLAIN" | grep -oE '[0-9]+' | head -1)"
    # The line's count cannot be compared to the pending lines: GUT prints each
    # pending test once while it runs and again in the Run Summary. What matters
    # is that the only non-passing category is `pending` — `risky` already
    # failed above — and that every pending test is listed for review below.
    :
elif [[ "$FAIL_COUNT" != "0" ]]; then
    : # the count and the failing-test list above already say it
elif (( STALL_HIT || TIMEOUT_HIT || COLLECT_ABORT || LOG_BLOWN )); then
    # The failure above already says why there is no summary.
    :
elif (( JUDGED )); then
    FINAL_LINE="$(grep -oE -- '---- .* ----' "$PLAIN" | tail -n 1 || true)"
    FAILURES+=("the run did not end with 'All tests passed!'${FINAL_LINE:+ (it ended: $FINAL_LINE)}")
fi

shopt -s nullglob
DIRECT=()
for dir in "${TEST_DIRS[@]}"; do
    for file in "$dir"/test_*.gd; do
        DIRECT+=("$file")
    done
done
EXPECTED="${#DIRECT[@]}"

is_direct() {
    local candidate="$1" f
    for f in "${DIRECT[@]}"; do
        if [[ "$f" == "$candidate" ]]; then
            return 0
        fi
    done
    return 1
}

NESTED=()
while IFS= read -r file; do
    is_direct "$file" || NESTED+=("$file")
done < <(find "${TEST_DIRS[@]}" -name 'test_*.gd' | sort)

if (( ! IS_FILTERED )); then
    if [[ -n "$SCRIPTS_RAN" && "$SCRIPTS_RAN" != "$EXPECTED" ]]; then
        UNTRUSTED+=("GUT ran $SCRIPTS_RAN scripts; ${TEST_DIRS[*]} hold $EXPECTED")
    fi
    if [[ -n "$SCRIPTS_RAN" && -n "$TESTS_RAN" && "$TESTS_RAN" -lt "$SCRIPTS_RAN" ]]; then
        UNTRUSTED+=("$SCRIPTS_RAN scripts ran only $TESTS_RAN tests — a script collected none")
    fi
else
    if [[ -z "$SCRIPTS_RAN" || "$SCRIPTS_RAN" -lt 1 ]]; then
        UNTRUSTED+=("no test scripts ran matching the filter")
    fi
    if [[ -z "$TESTS_RAN" || "$TESTS_RAN" -lt 1 ]]; then
        UNTRUSTED+=("no tests ran matching the filter")
    fi
fi
if (( ${#NESTED[@]} > 0 )); then
    UNTRUSTED+=("GUT does not recurse into subdirectories; these never run:")
    for file in "${NESTED[@]}"; do
        UNTRUSTED+=("    $file")
    done
fi

if (( ${#UNTRUSTED[@]} > 0 )); then
    echo
    echo "gut-check: FAIL — this GUT run is not trustworthy" >&2
    for problem in "${UNTRUSTED[@]}"; do
        echo "  $problem" >&2
    done
fi
if (( ${#FAILURES[@]} > 0 )); then
    echo
    echo "gut-check: FAIL — the suite ran and reported failures" >&2
    for failure in "${FAILURES[@]}"; do
        echo "  $failure" >&2
    done
fi
if (( ${#UNTRUSTED[@]} > 0 || ${#FAILURES[@]} > 0 )); then
    exit 1
fi

if [[ "$PENDING" != "0" ]]; then
    echo
    echo "gut-check: pending test(s) — allowed, listed for review:"
    grep -E '^ *\[Pending\]' "$PLAIN" | sort -u | sed 's/^/  /'
fi
if [[ "$RISKY" != "0" ]]; then
    echo
    echo "gut-check: tests that ran without asserting:"
    grep -E '^ *\[Risky\]' "$PLAIN" | sort -u | sed 's/^/  /'
fi

echo
FILTER_LABEL=""
if (( IS_FILTERED )); then
    FILTER_LABEL=" (filtered)"
fi
if [[ "$PENDING" == "0" ]]; then
    echo "gut-check: OK${FILTER_LABEL} — $SCRIPTS_RAN scripts, $TESTS_RAN tests, all passed"
else
    echo "gut-check: OK${FILTER_LABEL} — $SCRIPTS_RAN scripts, $TESTS_RAN tests, $PENDING_TOTAL pending"
fi
