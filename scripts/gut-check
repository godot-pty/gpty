#!/usr/bin/env bash
# Run the GUT (GDScript) suite and judge the run, not just the exit code.
#
# GUT's exit code does not mean the suite ran. A parse error in any collected
# .gd makes the collector break into Godot's debugger and the process still
# exits 0 — measured: 1.3 s instead of ~60 s, four scripts executed instead of
# forty, no Run Summary anywhere in the output. ci-check printed PASS off that
# exit code, so the whole GDScript suite could stop running unnoticed.
#
# This script owns the GUT command — ci-check and ci.yml both call it, so the
# command and its guard cannot drift apart — and then checks the output:
#   1. no Godot parse/script error (how an aborted run announces itself);
#   2. a complete Run Summary, ending in "All tests passed!";
#   3. the script count GUT reports equals the test_*.gd files the -gdirs hold
#      (GUT does not recurse, so a test script nested below a -gdir would never
#      run — that is reported instead of silently shrinking the suite);
#   4. at least one test per collected script;
#   5. no `[Risky]` test (ran without asserting), and no `[Pending]` test
#      outside Windows — pending is how a test records a platform gap, so on
#      Linux/macOS it can only mean something was skipped by accident.
#
# Requires godot on PATH; GODOT=<path> overrides.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

GODOT="${GODOT:-$(command -v godot || true)}"
if [[ -z "$GODOT" ]]; then
    echo "gut-check: godot not found on PATH (set GODOT=<path>)" >&2
    exit 1
fi

# The one definition of what the run covers.
TEST_DIRS=(godot/tests/unit godot/tests/integration)

LOG="$(mktemp)"
PLAIN="$(mktemp)"

# ── A private endpoint and user profile for the suite ────────────────────
#
# The tests spawn real panes, and every gpty instance binds the control *and*
# event endpoints — one instance owns each. Running this gate while a workspace
# is open therefore made the test instance refuse the bind, set its own
# shutdown flag and quit mid-suite: measured 2026-10-14 as 12 scripts and no
# Run Summary at all, which reads as a crash rather than as "close the app".
#
# `GPTY_SOCKET` moves both endpoints (the event path is derived from the
# control one), so the suite never meets a developer's GUI; on Windows that is
# the same variable carrying a pipe name. The XDG dirs are the second half of
# the same rule: the suite's probe vaults, the vault index and the recovery
# copies stay inside the sandbox instead of the developer's real data and state
# directories, and a bare `Workspace` can no longer restore a real layout whose
# presence depends on the machine (the smoke sandboxes itself the same way).
#
# Windows ignores the XDG variables: Godot resolves `user://` through the Known
# Folder API and the Rust state dir comes from `%LOCALAPPDATA%`. Two levers
# cover that platform without either side guessing:
#   * `GPTY_TEST_USER_DIR` is the suite's user root. `BasePersistenceManager`
#     redirects every `user://` store through it and `history_db_path` does the
#     same for the scrollback database, so the stores and the gdext half cannot
#     disagree. It is set on every platform (on Unix it overlaps the XDG
#     sandbox on purpose: the seam is exercised by the normal gate, not only on
#     Windows).
#   * `LOCALAPPDATA`/`APPDATA` are the env-based half of Windows: the Rust
#     state and data directories read `%LOCALAPPDATA%` directly, so the plugin
#     store, vault index and recovery copies land in the sandbox too.
# No `--log-file`: Godot's file logging is off by default (`debug/file_logging`
# is unset in project.godot), so the run writes no engine log into the real user
# directory, and the pipeline below already captures stdout for the gate's
# judgment. The smoke uses the flag because it needs a failure-time engine log;
# adding it here was the only difference from the known-good Windows GUT run
# and the step hung with it (both the MSYS and the cygpath spelling), so it
# stays out until a Windows run can pin the cause. A bounded timeout below keeps
# a future hang from occupying the runner.
SANDBOX="$(mktemp -d)"
chmod 700 "$SANDBOX"
export XDG_RUNTIME_DIR="$SANDBOX/run"
export XDG_DATA_HOME="$SANDBOX/data"
export XDG_STATE_HOME="$SANDBOX/state"
mkdir -p "$XDG_RUNTIME_DIR" "$XDG_DATA_HOME" "$XDG_STATE_HOME" \
    "$SANDBOX/user" "$SANDBOX/localappdata" "$SANDBOX/roaming"
case "$(uname -s)" in
    MINGW* | MSYS* | CYGWIN*)
        IS_WINDOWS=1
        export GPTY_SOCKET='\\.\pipe\gpty-gut-'"$$"
        # Native processes cannot use the MSYS `/tmp/...` spelling, so the
        # sandbox is handed over as a Windows path.
        SANDBOX_WIN="$(cygpath -w "$SANDBOX")"
        export GPTY_TEST_USER_DIR="$SANDBOX_WIN\\user"
        export LOCALAPPDATA="$SANDBOX_WIN\\localappdata"
        export APPDATA="$SANDBOX_WIN\\roaming"
        ;;
    *)
        IS_WINDOWS=0
        export GPTY_SOCKET="$XDG_RUNTIME_DIR/gpty.sock"
        export GPTY_TEST_USER_DIR="$SANDBOX/user"
        ;;
esac
# A developer's shell may carry a secret this instance has no client for.
unset GPTY_SECRET

trap 'rm -f "$LOG" "$PLAIN"; rm -rf "$SANDBOX"' EXIT

# No `-d`: Godot parses it as `--debug`, so a runtime error in a test breaks
# into the interactive debugger (`Debugger Break`, `debug>`) — measured on
# Windows: one out-of-bounds index in a failing test flooded the step log
# with 1.7 GB of the same break and stalled the suite. Without it GUT records
# the failure and continues; the gate's own checks (Run Summary/all passed)
# are what judge the run, not Godot's debugger.
GUT_ARGS=(-s addons/gut/gut_cmdln.gd)
for dir in "${TEST_DIRS[@]}"; do
    GUT_ARGS+=("-gdir=res://${dir#godot/}")
done

# A hung suite must fail the gate, not hold the runner until GitHub's six-hour
# job cap. The suite is ~1.5 min here and ~3-5 min on Windows; 15 min is slack
# for a loaded runner. The deadline is enforced here rather than by `timeout`:
# Godot does not die on SIGTERM while a script waits, so `timeout 300` was
# still alive with its Godot child after seven minutes (measured 2026-11-02) —
# exactly how runs survived a 600 s cutoff. The same loop ends a run as soon as
# Godot reports a script/parse error: the collector cannot be judged after
# that, and waiting for the deadline hides the error the gate exists to report
# (measured: a deliberate parse error used to spend the whole timeout). The
# escalation is SIGTERM, one second, SIGKILL.
#
# A stalled run fails long before that deadline. The suite starts a test every
# ~0.15 s (913 tests in 134 s), and the longest single test waits 2.1 s, so
# two minutes with no output at all is a hang, not a slow test. Detecting that
# turns the measured wedge (a pane-spawning test stopped the suite; the run
# then burned the whole deadline) into a failure that names the test it stopped
# in, instead of a timeout a reader cannot attribute. `0` disables the check.
GUT_TIMEOUT="${GUT_TIMEOUT:-600}"
GUT_STALL_TIMEOUT="${GUT_STALL_TIMEOUT:-120}"
for var in GUT_TIMEOUT GUT_STALL_TIMEOUT; do
    if [[ ! "${!var}" =~ ^[0-9]+$ ]]; then
        echo "gut-check: $var must be a whole number of seconds" >&2
        exit 1
    fi
done

# `tail -f` streams the log to the terminal while the watchdog reads the same
# file; both stop once the child is reaped.
"$GODOT" --headless --path godot "${GUT_ARGS[@]}" >"$LOG" 2>&1 &
GUT_PID=$!
tail -n +1 -f "$LOG" 2>/dev/null &
TAIL_PID=$!
stop_tail() {
    kill "$TAIL_PID" 2>/dev/null || true
    wait "$TAIL_PID" 2>/dev/null || true
}

set +e
STATUS=0
TIMEOUT_HIT=0
PARSE_ABORT=0
STALL_HIT=0
LAST_SIZE=-1
LAST_PROGRESS=$SECONDS
DEADLINE=$(( SECONDS + GUT_TIMEOUT ))
while kill -0 "$GUT_PID" 2>/dev/null; do
    if grep -qE 'SCRIPT ERROR|Parse Error|Failed to load script' "$LOG" 2>/dev/null; then
        PARSE_ABORT=1
        break
    fi
    SIZE="$(wc -c <"$LOG" 2>/dev/null || echo -1)"
    if [[ "$SIZE" != "$LAST_SIZE" ]]; then
        LAST_SIZE="$SIZE"
        LAST_PROGRESS=$SECONDS
    elif (( GUT_STALL_TIMEOUT > 0 && SECONDS - LAST_PROGRESS >= GUT_STALL_TIMEOUT )); then
        STALL_HIT=1
        break
    fi
    if (( SECONDS >= DEADLINE )); then
        TIMEOUT_HIT=1
        break
    fi
    sleep 0.2
done
if (( PARSE_ABORT || TIMEOUT_HIT || STALL_HIT )); then
    kill -TERM "$GUT_PID" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
        kill -0 "$GUT_PID" 2>/dev/null || break
        sleep 0.2
    done
    kill -KILL "$GUT_PID" 2>/dev/null || true
fi
wait "$GUT_PID"
STATUS=$?
stop_tail
set -e

# GUT colourises through a pipe too; match on a plain copy.
ESC=$'\033'
sed -E "s/${ESC}\[[0-9;?]*[A-Za-z]//g" "$LOG" > "$PLAIN"

# Where a killed run stopped: GUT prints the script's `.gd` path and then
# `* <test name>` as each test begins, so the tail of the log names the test and
# file to reproduce. Read before the message so a stall and a deadline report
# the same way.
LAST_TEST="$(awk '/^\* / { name = $0 } END { print name }' "$PLAIN" | sed -E 's/^\* //')"
LAST_SCRIPT="$(awk '{
        if (match($0, /[a-z]+:\/\/[^ ]*\.gd/)) last = substr($0, RSTART, RLENGTH)
    }
    END { print last }' "$PLAIN")"

PROBLEMS=()

if (( STALL_HIT )); then
    PROBLEMS+=("the run produced no output for ${GUT_STALL_TIMEOUT}s and was killed (a hung test or process)")
elif (( TIMEOUT_HIT )); then
    PROBLEMS+=("the suite exceeded ${GUT_TIMEOUT}s and was killed (a hung test or process)")
fi
if (( STALL_HIT || TIMEOUT_HIT )); then
    if [[ -n "$LAST_TEST" ]]; then
        PROBLEMS+=("the last test started was: $LAST_TEST")
    fi
    if [[ -n "$LAST_SCRIPT" ]]; then
        PROBLEMS+=("in $LAST_SCRIPT")
        PROBLEMS+=("re-run it alone: ${GODOT} --headless --path godot -s addons/gut/gut_cmdln.gd -gdir=res://tests/unit -gdir=res://tests/integration -gselect=$(basename "$LAST_SCRIPT" .gd) -gexit")
    fi
    PROBLEMS+=("the last lines were:")
    while IFS= read -r line; do
        PROBLEMS+=("    $line")
    done < <(tail -n 8 "$PLAIN")
fi
if (( PARSE_ABORT )); then
    PROBLEMS+=("the run was aborted as soon as Godot reported a script/parse error — it cannot be judged")
elif [[ "$STATUS" -ne 0 ]] && (( ! STALL_HIT && ! TIMEOUT_HIT )); then
    PROBLEMS+=("godot exited $STATUS")
fi

ERROR_LINES="$(grep -Em5 'SCRIPT ERROR|Parse Error|Failed to load script' "$PLAIN" || true)"
if [[ -n "$ERROR_LINES" ]]; then
    PROBLEMS+=("Godot reported a script/parse error — the suite did not run:")
    while IFS= read -r line; do
        PROBLEMS+=("    $line")
    done <<<"$ERROR_LINES"
fi

# Totals block reads "Scripts              40" / "Tests               406".
SCRIPTS_RAN="$(awk '$1 == "Scripts" && $2 ~ /^[0-9]+$/ { print $2; exit }' "$PLAIN")"
TESTS_RAN="$(awk '$1 == "Tests" && $2 ~ /^[0-9]+$/ { print $2; exit }' "$PLAIN")"

if [[ -z "$SCRIPTS_RAN" || -z "$TESTS_RAN" ]] \
    && (( ! STALL_HIT && ! TIMEOUT_HIT && ! PARSE_ABORT )); then
    PROBLEMS+=("no Run Summary in the output — the run stopped before it finished")
fi

# Pending tests are allowed on Windows only, and printed: a fixture that needs a
# POSIX shell or a file mode has no Windows meaning, and hiding those is worse
# than showing them. Everywhere else a pending test is a skip nobody decided
# on — a missing extension, an absent fixture — and a suite that skips quietly
# reports green for code it never ran, so it fails the run instead.
# A *risky* test — one that ran without asserting — is a real smell, so it fails.
RISKY="$(grep -c '\[Risky\]' "$PLAIN" || true)"
PENDING="$(grep -c '\[Pending\]' "$PLAIN" || true)"
PENDING_TOTAL="0"
if [[ "$RISKY" != "0" ]]; then
    PROBLEMS+=("a test ran without asserting ([Risky])")
fi
if [[ "$PENDING" != "0" && "$IS_WINDOWS" != "1" ]]; then
    PROBLEMS+=("pending tests are a Windows-only allowance, but these skipped on $(uname -s):")
    while IFS= read -r line; do
        PROBLEMS+=("    $line")
    done < <(grep -E '^ *\[Pending\]' "$PLAIN" | sort -u)
fi
if grep -q -- '---- All tests passed! ----' "$PLAIN"; then
    :
elif [[ "$PENDING" != "0" ]] && grep -qE -- '---- [0-9]+ pending/risky tests\. ----' "$PLAIN"; then
    # The number in that sentence is the authoritative count (GUT prints each
    # pending test twice in the log, so the line count is not).
    PENDING_TOTAL="$(grep -oE -- '---- [0-9]+ pending/risky tests\. ----' "$PLAIN" | grep -oE '[0-9]+' | head -1)"
    # The line's count cannot be compared to the pending lines: GUT prints each
    # pending test once while it runs and again in the Run Summary. What matters
    # is that the only non-passing category is `pending` — `risky` already
    # failed above — and that every pending test is listed for review below.
    :
elif (( STALL_HIT || TIMEOUT_HIT || PARSE_ABORT )); then
    # The failure above already says why there is no summary.
    :
else
    PROBLEMS+=("the run did not end with 'All tests passed!'")
fi

shopt -s nullglob
declare -A DIRECT=()
for dir in "${TEST_DIRS[@]}"; do
    for file in "$dir"/test_*.gd; do
        DIRECT["$file"]=1
    done
done
EXPECTED="${#DIRECT[@]}"

NESTED=()
while IFS= read -r file; do
    [[ -n "${DIRECT[$file]:-}" ]] || NESTED+=("$file")
done < <(find "${TEST_DIRS[@]}" -name 'test_*.gd' | sort)

if [[ -n "$SCRIPTS_RAN" && "$SCRIPTS_RAN" != "$EXPECTED" ]]; then
    PROBLEMS+=("GUT ran $SCRIPTS_RAN scripts; ${TEST_DIRS[*]} hold $EXPECTED")
fi
if [[ -n "$SCRIPTS_RAN" && -n "$TESTS_RAN" && "$TESTS_RAN" -lt "$SCRIPTS_RAN" ]]; then
    PROBLEMS+=("$SCRIPTS_RAN scripts ran only $TESTS_RAN tests — a script collected none")
fi
if (( ${#NESTED[@]} > 0 )); then
    PROBLEMS+=("GUT does not recurse into subdirectories; these never run:")
    for file in "${NESTED[@]}"; do
        PROBLEMS+=("    $file")
    done
fi

if (( ${#PROBLEMS[@]} > 0 )); then
    echo
    echo "gut-check: FAIL — this GUT run is not trustworthy" >&2
    for problem in "${PROBLEMS[@]}"; do
        echo "  $problem" >&2
    done
    exit 1
fi

if [[ "$PENDING" != "0" ]]; then
    echo
    echo "gut-check: pending test(s) — allowed, listed for review:"
    grep -E '^ *\[Pending\]' "$PLAIN" | sort -u | sed 's/^/  /'
fi
if [[ "$RISKY" != "0" ]]; then
    echo
    echo "gut-check: tests that ran without asserting:"
    grep -E '^ *\[Risky\]' "$PLAIN" | sort -u | sed 's/^/  /'
fi

echo
if [[ "$PENDING" == "0" ]]; then
    echo "gut-check: OK — $SCRIPTS_RAN scripts, $TESTS_RAN tests, all passed"
else
    echo "gut-check: OK — $SCRIPTS_RAN scripts, $TESTS_RAN tests, $PENDING_TOTAL pending"
fi
