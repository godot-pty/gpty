#!/usr/bin/env bash
# Live pane-API smoke test: boots the GUI headless, drives the JSON-RPC
# CLI end-to-end (new-pane → status → inject → wait → read → broadcast →
# pane-run exit-code → kill), then tears down.
#
# Requires: godot on PATH, jq. All user data is sandboxed via XDG_DATA_HOME.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP="$(mktemp -d)"
export XDG_DATA_HOME="$TMP/data"
SOCK="$TMP/gpty.sock"
SECRET="smoke-secret"
GUI_PID=""
STEP="boot"

cleanup() {
    set +e
    if [[ -n "$GUI_PID" ]] && kill -0 "$GUI_PID" 2>/dev/null; then
        GPTY_SOCKET="$SOCK" GPTY_SECRET="$SECRET" "$ROOT/target/debug/gpty" daemon stop --json >/dev/null 2>&1
        # Give the graceful shutdown a moment; hard-kill only if stuck.
        for _ in $(seq 1 10); do
            kill -0 "$GUI_PID" 2>/dev/null || break
            sleep 0.3
        done
        kill -9 "$GUI_PID" 2>/dev/null
        wait "$GUI_PID" 2>/dev/null
    fi
    rm -rf "$TMP"
}
trap cleanup EXIT

fail() {
    echo "FAIL [$STEP]: $1" >&2
    exit 1
}

export GPTY_SOCKET="$SOCK"
export GPTY_SECRET="$SECRET"
GPTY="$ROOT/target/debug/gpty"

step() { STEP="$1"; echo "== $1"; }

# ── Build ──────────────────────────────────────────────────────────────
step "build"
( cd "$ROOT" && cargo build -p gpty-gdext -p gpty --quiet )
mkdir -p "$ROOT/godot/bin"
ln -sf ../../target/debug/libgpty_gdext.so "$ROOT/godot/bin/libgpty_gdext.linux.x86_64.so"

# ── Launch GUI headless ────────────────────────────────────────────────
step "launch"
( cd "$ROOT" && godot --headless --path godot >"$TMP/godot.log" 2>&1 ) &
GUI_PID=$!

for _ in $(seq 1 60); do
    if [[ -S "$SOCK" ]] && "$GPTY" daemon status --json >/dev/null 2>&1; then
        break
    fi
    sleep 0.5
done
"$GPTY" daemon status --json >/dev/null 2>&1 \
    || { tail -40 "$TMP/godot.log" >&2; fail "GUI did not become reachable in 30s"; }
# First frame is still settling (spawns, IPC poll) — give it a beat.
sleep 1.0

jq_assert() { # jq_assert <json> <jq-expr> <what>
    if ! jq -e "$2" <<<"$1" >/dev/null; then
        fail "$3 (got: $(echo "$1" | head -c 400))"
    fi
}

# ── new-pane + status ──────────────────────────────────────────────────
step "new-pane"
NEW_JSON=""
for _ in $(seq 1 5); do
    NEW_JSON="$("$GPTY" new-pane -t terminal --tags smoke --json 2>/dev/null || true)"
    if [[ -n "$NEW_JSON" ]] && jq -e '.result.pane_id != null' <<<"$NEW_JSON" >/dev/null 2>&1; then break; fi
    sleep 1.0
done
jq_assert "$NEW_JSON" '.result.pane_id != null' "new-pane must return pane_id"
ID="$(jq -r '.result.pane_id' <<<"$NEW_JSON")"

step "pane-status (running)"
ST=""
for _ in $(seq 1 20); do
    ST="$("$GPTY" pane-status "$ID" --json 2>/dev/null || true)"
    if [[ -n "$ST" ]] && jq -e '.result.running == true' <<<"$ST" >/dev/null 2>&1; then break; fi
    sleep 0.5
done
jq_assert "$ST" '.result.running == true' "pane must be running"

# ── inject → pane-wait → pane-read ─────────────────────────────────────
step "inject + pane-wait"
"$GPTY" inject "$ID" --text 'echo SMOKE_7X9Q2' --json >/dev/null
WAIT_JSON="$("$GPTY" pane-wait "$ID" --pattern 'SMOKE_7X9Q2' --timeout-ms 10000 --json)"
jq_assert "$WAIT_JSON" '.result.matched == true' "pane-wait must match injected marker"

step "pane-read"
READ_JSON="$("$GPTY" pane-read "$ID" --lines 50 --json)"
jq -e '.result.text | contains("SMOKE_7X9Q2")' <<<"$READ_JSON" >/dev/null \
    || fail "pane-read must contain injected marker"

# ── broadcast to tagged pane ───────────────────────────────────────────
step "broadcast"
BC_JSON="$("$GPTY" broadcast --tags smoke --text 'echo BROADCAST_OK' --json)"
jq_assert "$BC_JSON" '.result.count == 1' "broadcast must hit exactly the tagged pane"
BW_JSON="$("$GPTY" pane-wait "$ID" --pattern 'BROADCAST_OK' --timeout-ms 10000 --json)"
jq_assert "$BW_JSON" '.result.matched == true' "broadcast text must reach the pane"

# ── pane-run + exit code ───────────────────────────────────────────────
step "pane-run"
# pane-run spawns the command as a single executable (no shell) — use
# a real binary with a known exit code.
RUN_JSON="$("$GPTY" pane-run --command false --json)"
RUN_ID="$(jq -r '.result.pane_id' <<<"$RUN_JSON")"
[[ -n "$RUN_ID" && "$RUN_ID" != "null" ]] || fail "no pane_id in pane-run response"
RUN_ST=""
for _ in $(seq 1 30); do
    RUN_ST="$("$GPTY" pane-status "$RUN_ID" --json 2>/dev/null || true)"
    if [[ -n "$RUN_ST" ]] && jq -e '.result.running == false' <<<"$RUN_ST" >/dev/null 2>&1; then break; fi
    sleep 0.5
done
jq_assert "$RUN_ST" '.result.running == false' "pane-run pane must exit"
jq_assert "$RUN_ST" '.result.exit_code == 1' "pane-run exit code must be 1"
"$GPTY" kill-pane "$RUN_ID" --json >/dev/null

# ── kill-pane ──────────────────────────────────────────────────────────
step "kill-pane"
BEFORE="$("$GPTY" list-panes --json)"
"$GPTY" kill-pane "$ID" --json >/dev/null
AFTER="$("$GPTY" list-panes --json)"
BCOUNT="$(jq '.result.count' <<<"$BEFORE")"
ACOUNT="$(jq '.result.count' <<<"$AFTER")"
[[ "$ACOUNT" == "$((BCOUNT - 1))" ]] || fail "kill-pane must decrement pane count ($BCOUNT → $ACOUNT)"

step "teardown"
echo "PASS"
