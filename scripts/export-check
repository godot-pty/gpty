#!/usr/bin/env bash
# Run a Godot import/export command and judge its SCRIPT ERROR lines.
#
# Usage: scripts/export-check <label> -- <command...>
#        scripts/export-check --check-log <file>
#        scripts/export-check -h|--help
#
# The release import/export pass prints import-order noise while the shipped
# app itself starts clean. This gate keeps the four known import-pass classes
# as a closed list, so a genuinely broken script cannot hide in the noise:
# anything else that prints SCRIPT ERROR or "Failed to load script" fails the
# step. Do not widen the list without a log line proving the new class is also
# import-order noise.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

ALLOWED=(
    'Could not resolve class "BasePersistenceManager"'
    'Identifier "GptyTerminal" not declared'
    'Could not find type'
    'Cannot infer the type of "failure" variable'
)

usage() {
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
}

judge() {
    local label="$1" log="$2" bad=0 line pat ok
    while IFS= read -r line; do
        if [[ "$line" != *"SCRIPT ERROR"* && "$line" != *"Failed to load script"* ]]; then
            continue
        fi
        ok=0
        for pat in "${ALLOWED[@]}"; do
            if [[ "$line" == *"$pat"* ]]; then
                ok=1
                break
            fi
        done
        if ((!ok)); then
            printf 'export-check: %s: %s\n' "$label" "$line" >&2
            bad=1
        fi
    done <"$log"
    return "$bad"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

if [[ "${1:-}" == "--check-log" ]]; then
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    [[ -f "$2" ]] || { echo "export-check: $2 is not a file" >&2; exit 2; }
    judge "$2" "$2"
    exit $?
fi

if [[ $# -lt 3 || "$2" != "--" ]]; then
    usage >&2
    exit 2
fi
label="$1"
shift 2

log="$(mktemp)"
trap 'rm -f "$log"' EXIT
set +e
"$@" 2>&1 | tee "$log"
status=${PIPESTATUS[0]}
set -e
if [[ $status -ne 0 ]]; then
    exit "$status"
fi
judge "$label" "$log"
