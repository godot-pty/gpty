#!/usr/bin/env python3
"""Check the markdown the project ships: links, anchors and the split-page structure.

Standard library only; run from anywhere. Exits 1 and lists every problem found.

  * every relative link in a markdown file resolves to a file, and its #anchor
    resolves to a heading (links into Hugo shortcodes and absolute URLs are skipped)
  * `/images/...` links resolve under docs/static/images/
  * every docs/static/images/issue-*.png is referenced by a markdown page (an
    orphan capture is evidence nothing cites)
  * roadmap chain pages: front matter, one three-column table row shape
    (`| done | AREA-N | **Title** - text |`), a known area prefix, unique IDs and
    titles, no unescaped `|`, and no image inside a table row
  * ROADMAP.md, CHANGELOG.md and AGENTS.md link exactly the pages under
    docs/content/docs/{roadmap,changelog,agents}/, and nothing links a page that
    does not exist
  * README.md carries no hard-coded release version in the download file names
"""
import datetime
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# What ships is what this gate judges. `TEMP*` is the scratch convention
# `.gitignore` already ignores (blog drafts, forensics baselines); the walk sees
# the worktree, so without `TEMP/` here a draft's unfinished links fail a gate
# the file never ships through.
SKIP_PREFIXES = (
    '.git/', '.entire/', 'target/', 'node_modules/', 'godot/addons/', 'docs/public/',
    'docs/assets/', 'docs/resources/', 'docs/.cache/', 'docs/data/', 'TEMP/',
)
problems = []


def bad(where, msg):
    problems.append(f'{where}: {msg}')


def rel(path):
    return os.path.relpath(path, ROOT).replace(os.sep, '/')


def read(path):
    with open(os.path.join(ROOT, path), encoding='utf-8') as f:
        return f.read()


def markdown_files():
    out = []
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [d for d in dirnames
                       if not (rel(os.path.join(dirpath, d)) + '/').startswith(SKIP_PREFIXES)]
        for name in filenames:
            if name.endswith('.md'):
                path = rel(os.path.join(dirpath, name))
                if not path.startswith(SKIP_PREFIXES):
                    out.append(path)
    return sorted(out)


def slug(heading):
    h = re.sub(r'`', '', heading.strip().lower())
    h = re.sub(r'[^\w\- ]', '', h)
    return h.replace(' ', '-')


def strip_code(text):
    text = re.sub(r'```.*?```', '', text, flags=re.S)
    return re.sub(r'`[^`\n]*`', '', text)


def front_matter(text):
    m = re.match(r'---\n(.*?)\n---\n', text, re.S)
    if not m:
        return None
    return dict(
        (k.strip(), v.strip().strip('"'))
        for k, _, v in (line.partition(':') for line in m.group(1).split('\n')) if k.strip())


FILES = markdown_files()
ANCHORS = {}
for f in FILES:
    ANCHORS[f] = {slug(m.group(1)) for m in re.finditer(r'^#{1,6} (.+)$', strip_code(read(f)), re.M)}

# ── links and anchors ────────────────────────────────────────────────────
link_re = re.compile(r'(?<!\!)\[[^\]]*\]\(([^)\s]+)(?:\s+"[^"]*")?\)')
img_re = re.compile(r'!\[[^\]]*\]\(([^)\s]+)\)')
for f in FILES:
    text = strip_code(read(f))
    for m in link_re.finditer(text):
        url = m.group(1)
        if re.match(r'(https?:|mailto:)', url) or url.startswith('/') or '{{' in url:
            continue
        path, _, frag = url.partition('#')
        target = os.path.normpath(os.path.join(os.path.dirname(f), path)).replace(os.sep, '/') if path else f
        if path and not os.path.exists(os.path.join(ROOT, target)):
            bad(f, f'link to missing file: {url}')
        elif frag and target in ANCHORS and slug(frag) not in ANCHORS[target] and frag not in ANCHORS[target]:
            bad(f, f'link to missing anchor: {url}')
    for m in img_re.finditer(text):
        url = m.group(1)
        if not re.match(r'(https?:|/)', url) and not os.path.exists(os.path.join(ROOT, os.path.dirname(f), url)):
            bad(f, f'image not found: {url}')
        if url.startswith('/images/') and not os.path.exists(os.path.join(ROOT, 'docs/static', url.lstrip('/'))):
            bad(f, f'image not found under docs/static/: {url}')

# ── evidence images: every issue-*.png is on a page ──────────────────────
# A capture saved for a row or a changelog entry is evidence; one no page
# references is an orphan (the caption was never added, or the page went away).
# Only `issue-*` is checked: the release and blog images are not evidence.
IMAGE_REFS = set()
for f in FILES:
    for m in img_re.finditer(strip_code(read(f))):
        IMAGE_REFS.add(os.path.basename(m.group(1).split('#', 1)[0]))
IMAGES_DIR = os.path.join(ROOT, 'docs/static/images')
for name in sorted(os.listdir(IMAGES_DIR)):
    if name.startswith('issue-') and name.endswith('.png') and name not in IMAGE_REFS:
        bad(f'docs/static/images/{name}', 'evidence image is not referenced by any markdown page')

# ── split-page indexes: root file <-> pages ──────────────────────────────
for root_md, folder, fields in (
    ('ROADMAP.md', 'roadmap', ('title', 'weight')),
    ('CHANGELOG.md', 'changelog', ('title', 'date')),
    ('AGENTS.md', 'agents', ('title', 'weight')),
):
    d = f'docs/content/docs/{folder}'
    pages = sorted(p for p in os.listdir(os.path.join(ROOT, d)) if p.endswith('.md') and p != '_index.md')
    linked = set(re.findall(r'\]\(' + re.escape(d) + r'/([^)#]+\.md)', read(root_md)))
    for p in pages:
        if p not in linked:
            bad(root_md, f'does not link {d}/{p}')
        fm = front_matter(read(f'{d}/{p}'))
        missing = [field for field in fields if not fm or field not in fm]
        if missing:
            bad(f'{d}/{p}', f'front matter needs {", ".join(fields)}')
            continue
        if folder == 'changelog':
            try:
                datetime.date.fromisoformat(fm['date'])
            except ValueError:
                bad(f'{d}/{p}', f"date is not YYYY-MM-DD: {fm['date']!r}")
    for p in sorted(linked - set(pages)):
        bad(root_md, f'links missing page {d}/{p}')
    if not os.path.exists(os.path.join(ROOT, d, '_index.md')):
        bad(d, '_index.md is missing (the section would not render the root file)')

# ── code citations in roadmap rows ───────────────────────────────────────
# A row's proof is often a `path:line` reference, and nothing checked that the
# file still exists: a rename or a move turned the evidence into an
# unverifiable claim with every gate green. Existence is the honest test, not
# line content - a line that moved is still useful evidence, while a deleted
# subject is not. A bare basename is accepted when it names exactly one file;
# an ambiguous one fails, and the fix is the repo path in the row.
#
# The answer is the repository's truth, so the index is `git ls-files`, never a
# worktree walk: a built extension library or a fuzz run's output exists on the
# machine that produced it and not in a clean checkout, which would let the
# gate pass locally and fail in CI on the same commit (v0.8.3).
try:
    REPO_FILES = [p for p in subprocess.run(
        ['git', '-C', ROOT, 'ls-files', '-z'], check=True,
        capture_output=True, text=True).stdout.split('\0') if p]
except (OSError, subprocess.CalledProcessError) as exc:
    print(f'docs-check: cannot list tracked paths with git: {exc}', file=sys.stderr)
    sys.exit(2)
REPO_FILE_SET = set(REPO_FILES)
TRACKED_DIRS = set()
for _f in REPO_FILES:
    _parts = _f.split('/')[:-1]
    for _i in range(1, len(_parts) + 1):
        TRACKED_DIRS.add('/'.join(_parts[:_i]))
BY_BASENAME = {}
for f in REPO_FILES:
    BY_BASENAME.setdefault(os.path.basename(f), []).append(f)
CITATION = re.compile(
    r'`([\w.+\-/]+\.(?:rs|gd|py|sh|ya?ml|md|toml|json|cfg|ts|js)):(\d+)(?:-\d+)?`')


def check_citation(where, item):
    for m in CITATION.finditer(item):
        raw = m.group(1)
        path = raw.removeprefix('./')
        citation = m.group(0)[1:-1]
        # A directory component - even `./` - makes this a repo path; only a
        # bare basename is resolved against the unique-name index.
        if '/' in raw:
            if path not in REPO_FILE_SET:
                bad(where, f'citation to missing file: {citation}')
            continue
        hits = BY_BASENAME.get(path, [])
        if not hits:
            bad(where, f'citation to missing file: {citation}')
        elif len(hits) > 1:
            bad(where, f'ambiguous citation {citation} ({len(hits)} files); '
                       f'use a repo path, e.g. {hits[0]}')

# ── repo paths named by the agent guide ─────────────────────────────────
# A guide that names `crates/...`, `godot/...`, `scripts/...` or `docs/...`
# is claiming the path exists. A rename turned that into a dead pointer with
# every gate green (the plugin store moved into `crates/gpty-plugin` and the
# guide kept the CLI path), so existence is checked the way a roadmap
# citation is. Illustrative names and generated trees are skipped.
GUIDE_PREFIXES = ('crates/', 'godot/', 'scripts/', 'docs/', 'dist/', 'fuzz/',
                  'extensions/', 'githooks/')
# Trees a clean checkout never carries: build output and run artifacts. A guide
# names them as things a command produces, so their absence is not a dead
# pointer - and their presence on the machine that built them is not evidence.
GENERATED_TREES = ('dist', 'target', 'godot/bin', 'godot/.godot',
                   'fuzz/artifacts', 'fuzz/target', 'docs/public',
                   'docs/assets', 'docs/.cache', 'node_modules')
GUIDE_TOKEN = re.compile(r'`([\w.+\-/]+)`')
agent_dir = 'docs/content/docs/agents'
guides = ['AGENTS.md'] + [
    f'{agent_dir}/{p}' for p in sorted(os.listdir(os.path.join(ROOT, agent_dir)))
    if p.endswith('.md')]
for guide in guides:
    for m in GUIDE_TOKEN.finditer(read(guide)):
        token = m.group(1).rstrip('/')
        if not token.startswith(GUIDE_PREFIXES):
            continue
        if '<' in token or '*' in token or 'XXXXXX' in token:
            continue
        if any(token == tree or token.startswith(tree + '/')
               for tree in GENERATED_TREES):
            continue
        if token not in REPO_FILE_SET and token not in TRACKED_DIRS:
            bad(guide, f'path does not exist: {token}')

# ── roadmap tables ───────────────────────────────────────────────────────
m = re.search(r'ID prefix names[^(]*\(([A-Z, ]+)\)', read('ROADMAP.md'))
AREAS = {a.strip() for a in m.group(1).split(',')} if m else set()
if not AREAS:
    bad('ROADMAP.md', 'could not read the Area list from the opening text')
row_re = re.compile(r'^\| (✅|⬜) \| ([A-Z]+-\d+) \| (.+) \|$')
seen = {}
seen_titles = {}
rd = 'docs/content/docs/roadmap'
for p in sorted(os.listdir(os.path.join(ROOT, rd))):
    if not p.endswith('.md') or p == '_index.md':
        continue
    for n, line in enumerate(read(f'{rd}/{p}').split('\n'), 1):
        if not line.startswith('| ') or re.match(r'^\| (Done|:?-)', line):
            continue
        where = f'{rd}/{p}:{n}'
        if '![' in strip_code(line):
            bad(where, 'image inside a table row (list it under "## Screenshots" instead)')
        r = row_re.match(line)
        if not r:
            bad(where, 'row is not `| ✅/⬜ | AREA-N | **Title** - text |`')
            continue
        done, rid, item = r.groups()
        prefix = rid.split('-', 1)[0]
        if prefix not in AREAS:
            bad(where, f'unknown area prefix {prefix} in {rid}')
        if rid in seen:
            bad(where, f'ID duplicates {seen[rid]}')
        seen[rid] = where
        check_citation(where, item)
        if re.search(r'(?<!\\)\|', item):
            bad(where, 'unescaped | inside the item cell')
        t = re.match(r'\*\*(.+?)\*\*( - |$)', item)
        if not t:
            bad(where, 'item must start with **Title** followed by " - text"')
            continue
        title = t.group(1)
        if title in seen_titles:
            bad(where, f'title duplicates {seen_titles[title]}: {title[:60]}')
        seen_titles[title] = where

# ── site paths ───────────────────────────────────────────────────────────
# The docs site is served from the domain root (docs/hugo.yaml baseURL), so a
# leftover `/gpty/` prefix is invisible in the repo and fatal in production:
# every stylesheet and script 404s and the page renders as unstyled text on
# white. The github.io host is stale for the same reason once a custom domain
# is set. Both are source-level mistakes (the moving to gpty.dev kept two
# hardcoded card links and the old baseURL), so this reads the sources rather
# than the built site - the build is not committed and would hide them anyway.
SITE_TEXT_SUFFIXES = ('.md', '.gd', '.yaml', '.yml', '.json', '.sh', '.toml', '.cfg', '.html')
STALE_PREFIX = re.compile(r'(?<![\w-])/gpty/')
STALE_HOST = re.compile(r'godot-pty\.github\.io')
for dirpath, dirnames, filenames in os.walk(ROOT):
    rel_dir = rel(dirpath) + '/'
    dirnames[:] = [d for d in dirnames
                   if not (rel_dir + d + '/').startswith(SKIP_PREFIXES)
                   and not (rel_dir + d + '/').startswith(('dist/', 'godot/bin/', 'godot/.godot/'))]
    for name in filenames:
        if not name.endswith(SITE_TEXT_SUFFIXES):
            continue
        path = rel(os.path.join(dirpath, name))
        if path.startswith(SKIP_PREFIXES):
            continue
        try:
            text = read(path)
        except (OSError, UnicodeDecodeError):
            continue
        for n, line in enumerate(text.split('\n'), 1):
            if STALE_HOST.search(line):
                bad(f'{path}:{n}', 'names the old godot-pty.github.io host (the site is gpty.dev)')
            if STALE_PREFIX.search(line):
                bad(f'{path}:{n}', 'absolute site path starts with /gpty/ (the site is served from the root)')

# ── README ───────────────────────────────────────────────────────────────
if re.search(r'gpty-v\d+\.\d+\.\d+-', read('README.md')):
    bad('README.md', 'download file names hard-code a release version (use gpty-v<version>-...)')

if problems:
    print('\n'.join(problems))
    print(f'\ndocs-check: {len(problems)} problem(s) in {len(FILES)} markdown files')
    sys.exit(1)
print(f'docs-check: OK ({len(FILES)} markdown files, {len(seen)} roadmap rows)')
